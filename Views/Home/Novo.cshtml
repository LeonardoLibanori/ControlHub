@using ControleEstoqueLoja.Models
@{
    ViewData["Title"] = "Novo Produto";
}

<div class="container mt-4">
    <div class="product-form-panel">
        <h2 class="mb-4"><i class="bi bi-box-seam" aria-hidden="true"></i> Novo produto</h2>

        <form method="post" action="/Home/Novo">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">Nome do produto</label>
                <input type="text" name="nome" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Código de barras (bipe o produto)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-upc-scan"></i>
                    </span>
                    <input type="text"
                           name="codigoBarras"
                           id="inputCodigo"
                           class="form-control form-control-lg"
                           placeholder="Clique aqui e use o leitor..."
                           autocomplete="off" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Vendido por</label>
                @* A tela so oferece dois valores. Os `value` continuam sendo os nomes
                   do enum (o JS atualizarQuantidade e o servidor dependem deles).
                   Geladeira e Freezer seguem no enum para os produtos legados, e um
                   produto assim aparece aqui como "Unidade". *@
                <select name="tipo" id="tipoProduto" class="form-select" required onchange="atualizarQuantidade()">
                    <option value="Prateleira">Unidade</option>
                    <option value="PorPeso">Peso (kg)</option>
                </select>
            </div>

            <div class="mb-3">
                <label id="labelPreco" class="form-label fw-bold">Preço por kg (R$/kg)</label>
                <div class="input-group">
                    <span class="input-group-text">R$</span>
                    <input type="text" id="precoVisual" class="form-control" placeholder="0,00" required
                           oninput="formatarMoeda(this, 'precoReal')" />
                </div>
                <input type="hidden" name="preco" id="precoReal">
            </div>

            <div class="mb-4">
                <label id="labelQuantidade" class="form-label fw-bold">Quantidade inicial</label>
                <div class="input-group">
                    <input type="number" id="quantidadeVisual" class="form-control" min="0" step="any" required oninput="atualizarQuantidade()" />
                    <span id="unidadeQuantidade" class="input-group-text">kg</span>
                </div>
                <input type="hidden" name="quantidade" id="quantidadeReal" />
            </div>

            <div class="mb-3">
                <label id="labelEstoqueMinimo" class="form-label fw-bold">Estoque mínimo (alerta)</label>
                <div class="input-group">
                    <input type="number" id="estoqueMinimoVisual" class="form-control" min="0" step="any" placeholder="0 = sem alerta" oninput="sincronizarEstoqueMinimo()" />
                    <span id="unidadeEstoqueMinimo" class="input-group-text">un</span>
                </div>
                <input type="hidden" name="estoqueMinimo" id="estoqueMinimoReal" />
                <small class="text-muted">Zerado ou vazio = este produto nunca avisa "estoque baixo".</small>
            </div>

            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2 me-2" aria-hidden="true"></i>Salvar produto</button>
        </form>

        <div class="text-center mt-3">
            <a href="/Home/Index" class="btn btn-outline-secondary btn-sm">Voltar</a>
        </div>
    </div>
</div>

<script>
    function atualizarQuantidade() {
        const tipo = document.getElementById('tipoProduto').value;
        const input = document.getElementById('quantidadeVisual');
        const hidden = document.getElementById('quantidadeReal');
        const label = document.getElementById('labelQuantidade');
        const unidade = document.getElementById('unidadeQuantidade');
        const labelPreco = document.getElementById('labelPreco');

        if (tipo === 'PorPeso') {
            label.innerText = "Quantidade inicial:";
            unidade.innerText = "kg";
            input.step = "any";
            labelPreco.innerText = "Preço por kg (R$/kg):";
        } else {
            label.innerText = "Quantidade inicial:";
            unidade.innerText = "un";
            input.step = "1";
            labelPreco.innerText = "Preço unitário (R$):";
        }

        hidden.value = input.value.replace(',', '.');
        sincronizarEstoqueMinimo();
    }

    // O estoque mínimo usa a MESMA unidade da quantidade (kg / un). Mantém os
    // dois labels em sincronia quando o tipo do produto muda.
    function sincronizarEstoqueMinimo() {
        const tipo = document.getElementById('tipoProduto').value;
        const unidadeMin = document.getElementById('unidadeEstoqueMinimo');
        const labelMin = document.getElementById('labelEstoqueMinimo');
        const visual = document.getElementById('estoqueMinimoVisual');
        const hidden = document.getElementById('estoqueMinimoReal');

        const ePeso = tipo === 'PorPeso';
        if (unidadeMin) unidadeMin.innerText = ePeso ? "kg" : "un";
        if (labelMin) labelMin.innerText = ePeso ? "Estoque mínimo (alerta, kg):" : "Estoque mínimo (alerta, un):";
        if (visual) visual.step = ePeso ? "any" : "1";
        if (hidden) hidden.value = visual ? visual.value.replace(',', '.') : "";
    }

    atualizarQuantidade();

        function formatarMoeda(input, idOculto) {
        let valor = input.value.replace(/\D/g, "");
        if (valor === "") {
            input.value = "";
            if(idOculto) document.getElementById(idOculto).value = "";
            return;
        }
        // Exibe formatado no input que o usuário vê (ex: 12,20)
        input.value = (parseInt(valor) / 100).toFixed(2).replace(".", ",");

        // Se houver um ID oculto (como precoReal), guarda o valor puro (ex: 1220)
        if(idOculto) {
            document.getElementById(idOculto).value = valor;
        }

        // Retorna o valor limpo para uso em funções que não usam campos ocultos
        return valor;
    }

        // Previne que o leitor de código de barras envie o formulário antes da hora
    document.getElementById("inputCodigo").addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault(); // Não deixa o formulário ser enviado

            // Opcional: foca no campo Nome após o bip para agilizar
            document.querySelector('input[name="nome"]').focus();
        }
    });
</script>