@using ControleEstoqueLoja.Models
@{
    ViewData["Title"] = "Novo Produto";
}

<div class="container mt-4">
    <div class="product-form-panel">

        <h2 class="mb-4">Novo produto</h2>

        @* COMMIT 4 (modal Novo produto): o formulario fica dentro do
           [data-modal-conteudo] para o modal-form.js extrair e injetar. O <h2>
           e o container ficam FORA - o titulo do modal vem do gatilho
           (data-modal-titulo="Novo produto" no Index.cshtml). A logica que era
           um <script> inline aqui foi movida para wwwroot/js/produto-form.js
           (ProdutoForm.iniciar), que o modal-form.js reamarra ao injetar. *@
        <div data-modal-conteudo>
        <form method="post" action="/Home/Novo">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">Nome do produto</label>
                <input type="text" name="nome" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Código de barras (bipe o produto)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"></span>
                    <input type="text"
                           name="codigoBarras"
                           id="inputCodigo"
                           class="form-control form-control-lg"
                           placeholder="Clique aqui e use o leitor..."
                           autocomplete="off" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Vendido por</label>
                @* A tela so oferece dois valores. Os `value` continuam sendo os nomes
                   do enum (o JS atualizarQuantidade e o servidor dependem deles).
                   Geladeira e Freezer seguem no enum para os produtos legados, e um
                   produto assim aparece aqui como "Unidade". *@
                <select name="tipo" id="tipoProduto" class="form-select" required>
                    <option value="Prateleira">Unidade</option>
                    <option value="PorPeso">Peso (kg)</option>
                </select>
            </div>

            <div class="mb-3">
                <label id="labelPreco" class="form-label fw-bold">Preço unitário (R$)</label>
                <div class="input-group">
                    <span class="input-group-text">R$</span>
                    <input type="text" id="precoVisual" class="form-control" placeholder="0,00" required />
                </div>
                <input type="hidden" name="preco" id="precoReal">
            </div>

            <div class="mb-4">
                <label id="labelQuantidade" class="form-label fw-bold">Quantidade inicial</label>
                <div class="input-group">
                    <input type="number" id="quantidadeVisual" class="form-control" min="0" step="any" required />
                    <span id="unidadeQuantidade" class="input-group-text">un</span>
                </div>
                <input type="hidden" name="quantidade" id="quantidadeReal" />
            </div>

            <div class="mb-3">
                <label id="labelEstoqueMinimo" class="form-label fw-bold">Estoque mínimo (alerta, un)</label>
                <div class="input-group">
                    <input type="number" id="estoqueMinimoVisual" class="form-control" min="0" step="any" placeholder="0 = sem alerta" />
                    <span id="unidadeEstoqueMinimo" class="input-group-text">un</span>
                </div>
                <input type="hidden" name="estoqueMinimo" id="estoqueMinimoReal" />
                <small class="text-muted">Zerado ou vazio = este produto nunca avisa "estoque baixo".</small>
            </div>

            <button type="submit" class="btn btn-primary w-100">Salvar produto</button>
        </form>

        <div class="text-center mt-3">
            <a href="/Home/Index" class="btn btn-outline-secondary btn-sm" data-modal-fechar>Voltar</a>
        </div>
        </div>

    </div>
</div>

@* O <script> inline que existia aqui (atualizarQuantidade, sincronizarEstoqueMinimo,
   formatarMoeda e o listener do #inputCodigo) foi movido para
   wwwroot/js/produto-form.js, que expoe window.ProdutoForm.iniciar(raiz) e se
   auto-inicia na tela cheia; o modal-form.js o reamarra ao injetar no modal.
   Os atributos onchange/oninput foram removidos: a logica agora e amarrada por
   addEventListener, que sobrevive a injecao do modal (funcoes globais inline nao
   existem no escopo do conteudo importado). *@
<link rel="stylesheet" href="~/css/app-modal.css" asp-append-version="true" />
<script src="~/js/produto-form.js" asp-append-version="true"></script>
<script src="~/js/modal-form.js" asp-append-version="true"></script>
