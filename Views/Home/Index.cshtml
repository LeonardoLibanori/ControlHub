@model List<ControleEstoqueLoja.Models.Produto>

@*
    Exibe os avisos de TempData vindos das validações de Novo/Editar
    (preço negativo, estoque negativo, código de barras duplicado).
    Mesmo partial _Aviso usado em Produto.cshtml — sem duplicar HTML.
*@
@inject IAuthorizationService Autorizacao
@{
    var mensagemErro = TempData["Erro"] as string;

    // BUG-13 (commit 4): esta tela e do Operador (PodeOperarPDV), mas cada botao
    // dela chama uma action PodeGerenciarEstoque (so o Dono). A pergunta vai a
    // mesma IAuthorizationService das rotas: a view nao conhece nenhuma role,
    // entao ela nunca mostra um botao que so poderia terminar em 403.
    var podeGerenciarEstoque = (await Autorizacao.AuthorizeAsync(User, Policies.PodeGerenciarEstoque)).Succeeded;

    // FASE A - ITEM 3: o termo de busca vive na querystring (o form e GET).
    // A tela precisa dele para o botao "Exportar Excel" montar o link com o
    // MESMO filtro - sem isso, quem busca "leite" e exporta receberia a planilha
    // inteira, e a tela mentiria sobre o conteudo do arquivo.
    var buscaAtual = Context.Request.Query["busca"].ToString();
}

@if (!string.IsNullOrWhiteSpace(mensagemErro))
{
    <partial name="_Aviso" model="mensagemErro" />
}

@* QUADRÃO PRINCIPAL (O EXTERNO) *@
<div class="main-container">

    <h1 class="fw-bold">Estoque</h1>

    <div class="busca-container">
        <form method="get" asp-controller="Home" asp-action="Index" class="busca-form">
            <input type="text" name="busca" placeholder="Procurar produto..." value="@buscaAtual" />
            <button type="submit">Buscar</button>
        </form>
    </div>

    @if (podeGerenciarEstoque)
    {
        <div class="mb-4 d-flex flex-wrap gap-2">
            <a asp-controller="Home" asp-action="Novo" class="btn-novo">Novo produto</a>

            @* Exportar (item 3): leva o mesmo `buscaAtual` da tela, para o
               arquivo ter exatamente os produtos que estao na tabela. Sem o
               parametro, o link baixaria o estoque inteiro. O .xlsx respeita o
               MESMO filtro do CSV - trocar de formato nao troca o conteudo. *@
            <a asp-controller="Home"
               asp-action="ExportarEstoqueExcel"
               asp-route-busca="@buscaAtual"
               class="btn-exportar"
               title="Baixar o que está na tela (respeita a busca) em Excel (.xlsx)">
                 Exportar Excel
            </a>
        </div>
    }

    @* QUADRADO DA TABELA (ESTE FICA DENTRO DO MAIN-CONTAINER) *@
    <div class="tabela-card">
        <table class="table mb-0 tabela-responsiva tabela-responsiva--estoque">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Vendido por</th>
                    <th>Estoque</th>
                    @if (podeGerenciarEstoque)
                    {
                        <th class="text-center">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.EstoqueAbaixoDoMinimo ? "linha-estoque-baixo" : null)">
                        <td>
                            <a asp-controller="Home" asp-action="Produto" asp-route-id="@item.Id" class="produto-link">@item.Nome</a>
                        </td>
                        <td>@(item.Tipo == TipoProduto.PorPeso ? "Peso (kg)" : "Unidade")</td>
                        <td>
                            @* BUG-31: o numero, a unidade, o badge e o "minimo"
                               ficam dentro de UM container flex. Sem ele o
                               badge caia para a linha seguinte da celula e
                               aparecia torto, abaixo do numero. *@
                            <div class="estoque-valor-linha">
                                <span class="estoque-quantidade">
                                    @if (item.Tipo == TipoProduto.PorPeso)
                                    {
                                        @item.Quantidade.ToString("0.###") <span>kg</span>
                                    }
                                    else
                                    {
                                        @item.Quantidade.ToString("0") <span>un</span>
                                    }
                                </span>
                                @* Estoque mínimo (item 1): só aparece se o dono configurou
                                   um mínimo > 0 E o estoque atual caiu abaixo dele. *@
                                @if (item.EstoqueAbaixoDoMinimo)
                                {
                                    <span class="badge badge-estoque-baixo" title="Abaixo do estoque mínimo configurado">
                                        Estoque baixo
                                    </span>
                                    <div class="estoque-minimo-texto">
                                        mínimo: @item.EstoqueMinimo!.Value.ToString(item.Tipo == TipoProduto.PorPeso ? "0.###" : "0")
                                        <span>@(item.Tipo == TipoProduto.PorPeso ? "kg" : "un")</span>
                                    </div>
                                }
                            </div>
                        </td>
                        @if (podeGerenciarEstoque)
                        {
                            <td>
                                <div class="acoes acoes-com-repor">
                                    <a asp-controller="Home" asp-action="Editar" asp-route-id="@item.Id" class="btn-editar">Editar</a>
                                    <button type="button" class="btn-repor"
                                            data-repor
                                            data-id="@item.Id"
                                            data-nome="@item.Nome"
                                            data-estoque="@item.Quantidade.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-unidade="@(item.Tipo == TipoProduto.PorPeso ? "kg" : "un")"
                                            data-fracionado="@(item.Tipo == TipoProduto.PorPeso ? "true" : "false")">
                                        Repor
                                    </button>
                                    <form method="post" asp-controller="Home" asp-action="Excluir" style="display:inline;" onsubmit="return confirmarExclusao(event, this);">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-excluir">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div> @* <--- ESSE FECHAMENTO É O QUE COLOCA A TABELA DENTRO DO BRANCO *@

<script>
    function confirmarExclusao(event, form) {
        event.preventDefault();
        if (confirm("Tem certeza que deseja excluir este produto?")) {
            form.submit();
        }
    }
</script>

@* ===== MODAL REPOR ESTOQUE (uma vez por página) ===== *@
<div class="repor-overlay" id="modalRepor" hidden role="dialog" aria-modal="true" aria-labelledby="reporTitulo">
    <div class="repor-modal">
        <div class="repor-modal__header">
            <h2 class="repor-modal__title" id="reporTitulo">Repor estoque</h2>
            <button type="button" class="repor-modal__close" id="reporFechar" aria-label="Fechar">&times;</button>
        </div>
        <div class="repor-modal__body">
            <div class="repor-modal__info">
                <strong id="reporNomeProduto"></strong>
                <span id="reporEstoqueAtual">Estoque atual: —</span>
            </div>
            <label class="repor-modal__label">
                Quantidade a adicionar
                <input type="text" id="reporInput" inputmode="decimal" autocomplete="off" />
            </label>
            <div class="repor-modal__preview" id="reporPreview">Novo estoque: —</div>
            <div class="repor-modal__alert" id="reporAlerta" hidden role="alert"></div>
        </div>
        <div class="repor-modal__actions">
            <button type="button" class="repor-modal__btn repor-modal__btn--secondary" id="reporCancelar">Cancelar</button>
            <button type="button" class="repor-modal__btn repor-modal__btn--primary" id="reporConfirmar">Repor</button>
        </div>
        @Html.AntiForgeryToken()
    </div>
</div>

@* ===== ARQUIVOS ESPECÍFICOS DO REPOR (não carregados em layout compartilhado) ===== *@
<link rel="stylesheet" href="~/css/repor.css" asp-append-version="true" />
<script src="~/js/repor-estoque.js" asp-append-version="true"></script>