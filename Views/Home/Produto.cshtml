@model ControleEstoqueLoja.Models.Produto
@inject IAuthorizationService Autorizacao
@{
    // BUG-21: AjustarEstoque define TempData["Erro"] (ex.: "Estoque insuficiente!") ao
    // barrar a remoção, mas nenhuma view o exibia — o operador achava que o botão não
    // funcionava. O partial _Aviso transforma o TempData em um alerta SweetAlert2.
    var mensagemErro = TempData["Erro"] as string;

    // BUG-13 (commit 4): o Operador chega aqui pela consulta (PodeOperarPDV), mas o
    // formulario abaixo chama AjustarEstoque, que e PodeGerenciarEstoque (so o Dono).
    // Decide-se pela mesma policy da rota, nao pela role.
    var podeGerenciarEstoque = (await Autorizacao.AuthorizeAsync(User, Policies.PodeGerenciarEstoque)).Succeeded;
}

@if (!string.IsNullOrWhiteSpace(mensagemErro))
{
    <partial name="_Aviso" model="mensagemErro" />
}

<div class="main-container">
    <div class="text-center mb-4">
        <h1 class="fw-bold product-detail-title">@Model.Nome</h1>
        <p class="text-muted">Gerenciamento de Estoque Individual</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="tabela-card text-center">
                <h4 class="mb-3">Estoque Atual</h4>
                <div class="display-1 fw-bold @(Model.Quantidade <= 5 ? "text-danger" : "text-success")">
                    @if (Model.Tipo == TipoProduto.PorPeso)
                    {
                        @Model.Quantidade.ToString("0.###")
                        <span>kg</span>
                    }
                    else
                    {
                        @Model.Quantidade.ToString("0")
                        <span>un</span>
                    }
                </div>
                <p class="fs-5 text-muted">@(Model.Tipo == TipoProduto.PorPeso ? "Quilos" : "Unidades")</p>

                <hr />

                @if (podeGerenciarEstoque)
                {
                    <form asp-action="AjustarEstoque" method="post" class="p-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Quantidade para ajuste</label>
                            <input type="number" name="quantidadeAjuste" class="form-control form-control-lg text-center" placeholder="0" min="1" step="any" required />
                        </div>

                        <div class="d-flex gap-3 justify-content-center">
                            <button type="submit" name="operacao" value="adicionar" class="btn-ajuste btn-add">Adicionar</button>
                            <button type="submit" name="operacao" value="remover" class="btn-ajuste btn-rem">Remover</button>
                        </div>
                    </form>
                }
                else
                {
                    @* Operador: mostra o estoque (que ele consulta) e diz por que
                       nao ha botao aqui - esconder sem explicar parecia tela quebrada. *@
                    <p class="text-muted p-3 mb-0">
                        Ajuste de estoque é função do dono. Esta tela está em modo consulta.
                    </p>
                }

                @* O "Voltar" estava dentro do form: saiu de la para continuar
                   visivel tambem no modo consulta do Operador. *@
                <div class="text-center mt-5">
                    <a asp-action="Index" class="btn-voltar-borda">
                        Voltar ao Estoque
                    </a>
                </div>
            </div>
        </div>
@* ---------------------------------------------------------------
       Histórico de PREÇO (item 2). Log informativo: não entra em
       nenhum cálculo de venda/saldo — é só a resposta para "isso
       antes custava quanto?". Mais recente primeiro (ordem do
       controller). Vem do ViewData, então pode ser nulo.
    *@
    @{
        var historicoPrecos = ViewData["HistoricoPrecos"] as List<ControleEstoqueLoja.Models.HistoricoPreco>;
    }
    <div class="row justify-content-center mt-4">
        <div class="col-12 col-lg-8">
            <div class="tabela-card">
                <h5 class="mb-3">Histórico de preço</h5>

                @if (historicoPrecos == null || historicoPrecos.Count == 0)
                {
                    <p class="text-muted mb-0">
                        Este produto ainda não teve o preço alterado.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Data</th>
                                    <th class="text-end">Preço anterior</th>
                                    <th class="text-end">Preço novo</th>
                                    <th class="text-end">Variação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in historicoPrecos)
                                {
                                    var subiu = h.PrecoNovo > h.PrecoAnterior;
                                    <tr>
                                        <td>@h.DataAlteracao.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end text-muted">R$ @h.PrecoAnterior.ToString("N2")</td>
                                        <td class="text-end fw-bold">R$ @h.PrecoNovo.ToString("N2")</td>
                                        <td class="text-end @(subiu ? "text-danger" : "text-success")">
                                            @(subiu ? "Subiu" : "Caiu")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</div>