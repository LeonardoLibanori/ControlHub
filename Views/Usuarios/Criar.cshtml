@model ControleEstoqueLoja.Controllers.CriarUsuarioViewModel
@{
    ViewData["Title"] = "Nova conta";
}

<div class="container" style="max-width: 520px; margin-top: 40px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="text-center mb-1"><i class="bi bi-person-plus" aria-hidden="true"></i> NOVA CONTA</h2>
            <p class="text-center text-muted mb-4">
                Crie o acesso de quem vai operar o sistema.
            </p>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <form method="post" asp-controller="Usuarios" asp-action="Criar">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label fw-bold"></label>
                    <input asp-for="Nome" class="form-control" autofocus autocomplete="off" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" class="form-control" autocomplete="off" />
                    <div class="form-text">É com este e-mail que a pessoa faz o login.</div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label fw-bold"></label>
                    <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Mínimo 6 caracteres, com 1 maiúscula, 1 minúscula e 1 número.</div>
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmarSenha" class="form-label fw-bold"></label>
                    <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Papel" class="form-label fw-bold"></label>
                    <select asp-for="Papel" class="form-select">
                        @* Operador vem primeiro de propósito: é o papel do balcão e
                           o padrão do formulário (menor privilégio). *@
                        <option value="@Roles.Operador">@Roles.Operador - só o PDV (vender e suprimento)</option>
                        <option value="@Roles.Dono">@Roles.Dono - acesso total (financeiro, estoque, usuários)</option>
                    </select>
                    <span asp-validation-for="Papel" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold"><i class="bi bi-check2 me-2" aria-hidden="true"></i>CRIAR CONTA</button>
            </form>

            <div class="text-center mt-3">
                <a href="/Usuarios/Index" class="btn btn-outline-secondary btn-sm">Voltar</a>
            </div>
        </div>
    </div>
</div>
