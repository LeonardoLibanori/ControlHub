@model List<ControleEstoqueLoja.Controllers.UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuários";
    var eu = User.Identity?.Name;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        @* Topo enxuto de propósito: so titulo + NOVA CONTA. Nao ha aviso de
           "quem entra no sistema" nem botao de voltar - a volta para o Caixa
           ja existe na navbar, e a tela fica limpa. *@
        <h2 class="mb-0">Usuários do sistema</h2>
        <a href="/Usuarios/Criar" class="btn btn-primary fw-bold">Nova conta</a>
    </div>

    @* TempData vem do POST Criar; o redirect para cá evita reenvio do formulário. *@
    @if (TempData["Aviso"] is string aviso)
    {
        <div class="alert alert-success py-2">@aviso</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">Nenhuma conta cadastrada.</div>
    }
    else
    {
        <div class="tabela-card">
            <table class="table table-hover align-middle bg-white tabela-responsiva tabela-responsiva--usuarios">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>E-mail (login)</th>
                        <th>Papel</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                @u.Nome
                                @if (!string.IsNullOrEmpty(eu) && eu == u.Email)
                                {
                                    <span class="badge bg-primary">você</span>
                                }
                            </td>
                            <td>@u.Email</td>
                            <td>
                                @foreach (var papel in u.Papeis)
                                {
                                    @* Papel desconhecido continua aparecendo: melhor
                                       ver o que está gravado do que esconder. *@
                                    var cor = papel == Roles.Dono ? "bg-danger" : "bg-secondary";
                                    <span class="badge @cor">@papel</span>
                                }
                            </td>
                            <td>
                                @if (u.Bloqueado)
                                {
                                    <span class="text-danger fw-bold">Bloqueado (tentativas erradas)</span>
                                }
                                else
                                {
                                    <span class="text-success">Ativo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@u.Id"
                                   class="btn btn-outline-secondary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
