@model List<ControleEstoqueLoja.Controllers.UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuários";
    var eu = User.Identity?.Name;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-0"><i class="bi bi-people" aria-hidden="true"></i> USUÁRIOS DO SISTEMA</h2>
            <small class="text-muted">
                Quem entra no sistema e com qual papel. Só o Dono acessa esta tela
                (<code>/Usuarios</code>).
            </small>
        </div>
        <a href="/Usuarios/Criar" class="btn btn-primary fw-bold"><i class="bi bi-person-plus me-2" aria-hidden="true"></i>NOVA CONTA</a>
    </div>

    @* TempData vem do POST Criar; o redirect para cá evita reenvio do formulário. *@
    @if (TempData["Aviso"] is string aviso)
    {
        <div class="alert alert-success py-2">@aviso</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">Nenhuma conta cadastrada.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>E-mail (login)</th>
                        <th>Papel</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                @u.Nome
                                @if (!string.IsNullOrEmpty(eu) && eu == u.Email)
                                {
                                    <span class="badge bg-primary">você</span>
                                }
                            </td>
                            <td>@u.Email</td>
                            <td>
                                @foreach (var papel in u.Papeis)
                                {
                                    @* Papel desconhecido continua aparecendo: melhor
                                       ver o que está gravado do que esconder. *@
                                    var cor = papel == Roles.Dono ? "bg-danger" : "bg-secondary";
                                    <span class="badge @cor">@papel</span>
                                }
                            </td>
                            <td>
                                @if (u.Bloqueado)
                                {
                                    <span class="text-danger fw-bold">Bloqueado (tentativas erradas)</span>
                                }
                                else
                                {
                                    <span class="text-success">Ativo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@u.Id"
                                   class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <a href="/Caixa/Index" class="btn btn-outline-secondary btn-sm">Voltar ao caixa</a>
    </div>
</div>
