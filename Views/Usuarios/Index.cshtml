@model List<ControleEstoqueLoja.Controllers.UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuários";
    var eu = User.Identity?.Name;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        @* Topo enxuto de propósito: so titulo + NOVA CONTA. Nao ha aviso de
           "quem entra no sistema" nem botao de voltar - a volta para o Caixa
           ja existe na navbar, e a tela fica limpa. *@
        <h2 class="mb-0">Usuários do sistema</h2>
        <a href="/Usuarios/Criar" class="btn btn-primary fw-bold" data-modal-form data-modal-titulo="Nova conta">Nova conta</a>
    </div>

    @* TempData vem do POST Criar; o redirect para cá evita reenvio do formulário. *@
    @if (TempData["Aviso"] is string aviso)
    {
        <div class="alert alert-success py-2">@aviso</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">Nenhuma conta cadastrada.</div>
    }
    else
    {
        <div class="tabela-card">
            <table class="table table-hover align-middle tabela-responsiva tabela-responsiva--usuarios">
                <thead>
                    <tr>
                        <th class="col-nome">Nome</th>
                        <th class="col-email">E-mail (login)</th>
                        <th class="col-papel">Papel</th>
                        <th class="col-situacao">Situação</th>
                        <th class="text-end col-acoes">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-bold col-nome" data-label="Nome">
                                @u.Nome
                                @if (!string.IsNullOrEmpty(eu) && eu == u.Email)
                                {
                                    <span class="badge bg-primary">você</span>
                                }
                            </td>
                            <td class="col-email" data-label="E-mail">@u.Email</td>
                            <td class="col-papel" data-label="Papel">
                                @foreach (var papel in u.Papeis)
                                {
                                    @* Papel desconhecido continua aparecendo: melhor
                                       ver o que está gravado do que esconder. *@
                                    var cor = papel == Roles.Dono ? "bg-danger" : "bg-secondary";
                                    <span class="badge @cor">@(papel == Roles.Dono ? "Administrador" : papel)</span>
                                }
                            </td>
                            <td class="col-situacao" data-label="Situação">
                                @if (u.Bloqueado)
                                {
                                    <span class="text-danger fw-bold">Bloqueado (tentativas erradas)</span>
                                }
                                else
                                {
                                    <span class="text-success">Ativo</span>
                                }
                            </td>
                            <td class="text-end col-acoes" data-label="Ações">
                                <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@u.Id"
                                   class="btn btn-outline-secondary btn-sm"
                                   data-modal-form data-modal-titulo="Editar conta">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Modais de contas (COMMIT 3 e 4): o modal-form.js busca /Usuarios/Criar ou
   /Usuarios/Editar/{id} e injeta o [data-modal-conteudo] da view correspondente
   (titulo vem do data-modal-titulo do gatilho). Sem produto-form.js - nao ha
   formulario de produto aqui. *@
<link rel="stylesheet" href="~/css/app-modal.css" asp-append-version="true" />
<script src="~/js/modal-form.js" asp-append-version="true"></script>
