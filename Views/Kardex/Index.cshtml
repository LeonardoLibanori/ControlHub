@model ControleEstoqueLoja.Controllers.KardexPaginaViewModel
@using ControleEstoqueLoja.Data
@using ControleEstoqueLoja.Models

<div class="main-container">
    <h1 class="fw-bold">Kardex</h1>
    <p class="text-muted">Movimentações de estoque a partir desta implantação. Saldos anteriores à migration não foram reconstruídos.</p>

    <form method="get" asp-controller="Kardex" asp-action="Index" class="mb-4">
        <div class="filtros-grid">
            <div class="campo-filtro">
                <label class="form-label" for="kardex-produto">Produto</label>
                <select id="kardex-produto" name="produtoId" class="form-control">
                    <option value="">Todos</option>
                    @foreach (var produto in Model.Produtos)
                    {
                        <option value="@produto.Id" selected="@(Model.ProdutoId == produto.Id)">@produto.Nome</option>
                    }
                </select>
            </div>
            <div class="campo-filtro">
                <label class="form-label" for="kardex-tipo">Tipo</label>
                <select id="kardex-tipo" name="tipo" class="form-control">
                    <option value="">Todos</option>
                    <option value="@((int)TipoMovimentacaoEstoque.Entrada)" selected="@(Model.Tipo == TipoMovimentacaoEstoque.Entrada)">Entrada</option>
                    <option value="@((int)TipoMovimentacaoEstoque.Saida)" selected="@(Model.Tipo == TipoMovimentacaoEstoque.Saida)">Saída</option>
                    <option value="@((int)TipoMovimentacaoEstoque.Ajuste)" selected="@(Model.Tipo == TipoMovimentacaoEstoque.Ajuste)">Ajuste</option>
                </select>
            </div>
            <div class="campo-filtro">
                <label class="form-label" for="kardex-de">De</label>
                <input id="kardex-de" type="date" name="de" class="form-control" value="@(Model.De?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="campo-filtro">
                <label class="form-label" for="kardex-ate">Até</label>
                <input id="kardex-ate" type="date" name="ate" class="form-control" value="@(Model.Ate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="campo-filtro">
                <label class="form-label" for="kardex-origem">Origem</label>
                <input id="kardex-origem" type="text" name="origemTipo" class="form-control" value="@Model.OrigemTipo" placeholder="Venda, Reposicao..." />
            </div>
            <div class="campo-filtro">
                <label class="form-label" for="kardex-origem-id">Id da origem</label>
                <input id="kardex-origem-id" type="number" name="origemId" class="form-control" value="@Model.OrigemId" />
            </div>
            <div class="campo-filtro">
                <label class="form-label" for="kardex-usuario">Usuário</label>
                <input id="kardex-usuario" type="text" name="usuarioId" class="form-control" value="@Model.UsuarioId" />
            </div>
            <button type="submit" class="btn-filtrar">Filtrar</button>
        </div>
    </form>

    <p class="text-muted">@Model.TotalRegistros registro(s) · página @Model.Pagina de @Model.TotalPaginas</p>

    <div class="tabela-card">
        <table class="table mb-0 tabela-responsiva">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Produto</th>
                    <th>Tipo</th>
                    <th>Quantidade</th>
                    <th>Saldo</th>
                    <th>Origem</th>
                    <th>Usuário</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Itens.Count == 0)
            {
                <tr>
                    <td colspan="7" class="estado-vazio">
                        Nenhuma movimentação neste filtro.
                    </td>
                </tr>
            }
            else
            {
                foreach (var linha in Model.Itens)
                {
                    var classeTipo = linha.Tipo switch
                    {
                        TipoMovimentacaoEstoque.Entrada => "badge-tipo-entrada",
                        TipoMovimentacaoEstoque.Saida => "badge-tipo-saida",
                        TipoMovimentacaoEstoque.Ajuste => "badge-tipo-ajuste",
                        _ => "badge-tipo-neutro"
                    };
                    var iconeTipo = linha.Tipo switch
                    {
                        TipoMovimentacaoEstoque.Entrada => "+",
                        TipoMovimentacaoEstoque.Saida => "–",
                        TipoMovimentacaoEstoque.Ajuste => "↻",
                        _ => "•"
                    };
                    var rotuloTipo = linha.Tipo switch
                    {
                        TipoMovimentacaoEstoque.Entrada => "Entrada",
                        TipoMovimentacaoEstoque.Saida => "Saída",
                        TipoMovimentacaoEstoque.Ajuste => "Ajuste",
                        _ => linha.Tipo.ToString()
                    };
                    <tr>
                        <td data-label="Data">@linha.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Produto">
                            <strong class="produto-link">@linha.ProdutoNome</strong>
                        </td>
                        <td data-label="Tipo">
                            <span class="badge-tipo @classeTipo" data-icon="@iconeTipo">@rotuloTipo</span>
                        </td>
                        <td data-label="Quantidade" class="dash-num">@FormatoPtBr.Quantidade(linha.QuantidadeMovimentada)</td>
                        <td data-label="Saldo" class="dash-num">
                            <span class="td-antes">@FormatoPtBr.Quantidade(linha.SaldoAnterior)</span>
                            <span class="text-muted">→</span>
                            <span class="td-depois">@FormatoPtBr.Quantidade(linha.SaldoPosterior)</span>
                        </td>
                        <td data-label="Origem">@linha.OrigemTipo@(linha.OrigemId is null ? "" : " #" + linha.OrigemId)@(string.IsNullOrWhiteSpace(linha.Motivo) ? "" : " · " + linha.Motivo)</td>
                        <td data-label="Usuário">@(linha.UsuarioNome ?? linha.UsuarioId ?? "—")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <div class="d-flex gap-2 mt-3">
            @if (Model.Pagina > 1)
            {
                <a class="btn-voltar-borda" asp-action="Index"
                   asp-route-produtoId="@Model.ProdutoId"
                   asp-route-de="@(Model.De?.ToString("yyyy-MM-dd"))"
                   asp-route-ate="@(Model.Ate?.ToString("yyyy-MM-dd"))"
                   asp-route-tipo="@((int?)Model.Tipo)"
                   asp-route-usuarioId="@Model.UsuarioId"
                   asp-route-origemTipo="@Model.OrigemTipo"
                   asp-route-origemId="@Model.OrigemId"
                   asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a class="btn-voltar-borda" asp-action="Index"
                   asp-route-produtoId="@Model.ProdutoId"
                   asp-route-de="@(Model.De?.ToString("yyyy-MM-dd"))"
                   asp-route-ate="@(Model.Ate?.ToString("yyyy-MM-dd"))"
                   asp-route-tipo="@((int?)Model.Tipo)"
                   asp-route-usuarioId="@Model.UsuarioId"
                   asp-route-origemTipo="@Model.OrigemTipo"
                   asp-route-origemId="@Model.OrigemId"
                   asp-route-pagina="@(Model.Pagina + 1)">Próxima</a>
            }
        </div>
    }

</div>