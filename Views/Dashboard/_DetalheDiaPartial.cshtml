@model ControleEstoqueLoja.Controllers.DashboardDetalheDiaViewModel
@using System.Globalization
@{
    var br = CultureInfo.GetCultureInfo("pt-BR");
    string Dinheiro(decimal valor) => valor.ToString("C", br);
    string Qtd(decimal valor) => valor.ToString("0.###", br);
}

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="dsh-alert dsh-alert-erro">@Model.Erro</div>
}
else
{
    <div class="dsh-detalhe-dia">

        @* ===== CABECALHO DO DIA ===== *@
        <div class="dsh-detalhe-cabecalho">
            <h2 class="dsh-detalhe-titulo">Detalhes de @Model.Dia.ToString("dd/MM/yyyy", br)</h2>
            <span class="dsh-detalhe-status @(Model.CaixaFechado ? "dsh-status-fechado" : "dsh-status-aberto")">
                @(Model.CaixaFechado ? "Caixa Fechado" : "Caixa Aberto")
                @if (Model.HorarioFechamento.HasValue)
                {
                    <span> · Fechado às @Model.HorarioFechamento.Value.ToString("HH:mm", br)</span>
                }
            </span>
        </div>

        @* ===== RESUMO FINANCEIRO ===== *@
        <div class="dsh-grade">
            <div class="dsh-kpi-card">
                <span class="dsh-kpi-ponto" style="background:var(--c-blue)"></span>
                <span class="dsh-kpi-rotulo">Total do Dia</span>
                <strong class="dsh-kpi-valor">@Dinheiro(Model.TotalDia)</strong>
                <span class="dsh-kpi-observacao">@Model.NumeroVendas @(Model.NumeroVendas == 1 ? "venda" : "vendas") · Ticket @Dinheiro(Model.TicketMedio)</span>
            </div>

            <div class="dsh-kpi-card">
                <span class="dsh-kpi-ponto" style="background:var(--c-green)"></span>
                <span class="dsh-kpi-rotulo">Suprimentos</span>
                <strong class="dsh-kpi-valor dsh-positivo">@Dinheiro(Model.TotalSuprimentos)</strong>
                <span class="dsh-kpi-observacao">@Model.Suprimentos.Count @(Model.Suprimentos.Count == 1 ? "registro" : "registros")</span>
            </div>

            <div class="dsh-kpi-card">
                <span class="dsh-kpi-ponto" style="background:var(--c-coral)"></span>
                <span class="dsh-kpi-rotulo">Sangrias</span>
                <strong class="dsh-kpi-valor dsh-negativo">@Dinheiro(Model.TotalSangrias)</strong>
                <span class="dsh-kpi-observacao">@Model.Sangrias.Count @(Model.Sangrias.Count == 1 ? "registro" : "registros")</span>
            </div>

            <div class="dsh-kpi-card">
                <span class="dsh-kpi-ponto" style="background:var(--c-cyan)"></span>
                <span class="dsh-kpi-rotulo">Saldo Esperado (Dinheiro)</span>
                <strong class="dsh-kpi-valor @((Model.TotalDia - Model.TotalSangrias + Model.TotalSuprimentos < 0) ? "dsh-negativo" : "")">
                    @Dinheiro(Model.TotalDia - Model.TotalSangrias + Model.TotalSuprimentos)
                </strong>
                <span class="dsh-kpi-observacao">Vendas dinheiro + Suprimentos - Sangrias</span>
            </div>
        </div>

        @* ===== VENDAS POR FORMA DE PAGAMENTO ===== *@
        <div class="dsh-secao">
            <h3 class="dsh-secao-titulo">Vendas por Forma de Pagamento</h3>
            @if (Model.TotalPorMetodo.Count == 0)
            {
                <p class="dsh-vazio">Nenhuma venda registrada neste dia.</p>
            }
            else
            {
                <div class="dsh-tabela-container dsh-tabela-responsiva">
                    <table class="dsh-tabela">
                        <thead>
                            <tr>
                                <th scope="col">Forma</th>
                                <th scope="col" class="dsh-num">Total</th>
                                <th scope="col" class="dsh-num">Qtd. Vendas</th>
                                <th scope="col" class="dsh-num">% do Dia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.TotalPorMetodo)
                            {
                                var pct = Model.TotalDia > 0 ? (m.Total / Model.TotalDia * 100m) : 0m;
                                <tr>
                                    <td>@m.Metodo</td>
                                    <td class="dsh-num">@Dinheiro(m.Total)</td>
                                    <td class="dsh-num">@Model.Vendas.Count(v => v.MetodoPagamento.Equals(m.Metodo, StringComparison.OrdinalIgnoreCase))</td>
                                    <td class="dsh-num">@pct.ToString("0.##", br)%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== SUPRIMENTOS ===== *@
        <div class="dsh-secao">
            <h3 class="dsh-secao-titulo">Suprimentos (@Model.Suprimentos.Count)</h3>
            @if (Model.Suprimentos.Count == 0)
            {
                <p class="dsh-vazio">Nenhum suprimento registrado neste dia.</p>
            }
            else
            {
                <div class="dsh-tabela-container dsh-tabela-responsiva">
                    <table class="dsh-tabela">
                        <thead>
                            <tr>
                                <th scope="col">Hora</th>
                                <th scope="col" class="dsh-num">Valor</th>
                                <th scope="col">Descrição</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Suprimentos)
                            {
                                <tr class="@(s.IsFechado ? "dsh-linha-fechada" : "")">
                                    <td>@s.Data.ToString("HH:mm", br)</td>
                                    <td class="dsh-num dsh-positivo">@Dinheiro(s.Valor)</td>
                                    <td>@s.Descricao</td>
                                    <td>
                                        <span class="dsh-badge @(s.IsFechado ? "dsh-badge-fechado" : "dsh-badge-aberto")">
                                            @(s.IsFechado ? "Fechado" : "Aberto")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== SANGRIAS ===== *@
        <div class="dsh-secao">
            <h3 class="dsh-secao-titulo">Sangrias (@Model.Sangrias.Count)</h3>
            @if (Model.Sangrias.Count == 0)
            {
                <p class="dsh-vazio">Nenhuma sangria registrada neste dia.</p>
            }
            else
            {
                <div class="dsh-tabela-container dsh-tabela-responsiva">
                    <table class="dsh-tabela">
                        <thead>
                            <tr>
                                <th scope="col">Hora</th>
                                <th scope="col" class="dsh-num">Valor</th>
                                <th scope="col">Descrição</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Sangrias)
                            {
                                <tr class="@(s.IsFechado ? "dsh-linha-fechada" : "")">
                                    <td>@s.Data.ToString("HH:mm", br)</td>
                                    <td class="dsh-num dsh-negativo">@Dinheiro(Math.Abs(s.Valor))</td>
                                    <td>@s.Descricao</td>
                                    <td>
                                        <span class="dsh-badge @(s.IsFechado ? "dsh-badge-fechado" : "dsh-badge-aberto")">
                                            @(s.IsFechado ? "Fechado" : "Aberto")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== PRODUTOS VENDIDOS (AGRUPADOS) ===== *@
        <div class="dsh-secao">
            <h3 class="dsh-secao-titulo">Produtos Vendidos (@Model.Produtos.Count)</h3>
            @if (Model.Produtos.Count == 0)
            {
                <p class="dsh-vazio">Nenhum produto vendido neste dia.</p>
            }
            else
            {
                <div class="dsh-tabela-container dsh-tabela-responsiva">
                    <table class="dsh-tabela">
                        <thead>
                            <tr>
                                <th scope="col">Produto</th>
                                <th scope="col" class="dsh-num">Quantidade</th>
                                <th scope="col" class="dsh-num">Valor Total</th>
                                <th scope="col" class="dsh-num">% do Dia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Produtos)
                            {
                                var pct = Model.TotalDia > 0 ? (p.Valor / Model.TotalDia * 100m) : 0m;
                                <tr class="@(p.Quantidade <= 0 ? "dsh-linha-zerado" : "")">
                                    <td>
                                        <a asp-controller="Home" asp-action="Produto" asp-route-id="@p.ProdutoId">@p.Nome</a>
                                    </td>
                                    <td class="dsh-num">@Qtd(p.Quantidade) @p.Unidade</td>
                                    <td class="dsh-num">@Dinheiro(p.Valor)</td>
                                    <td class="dsh-num">@pct.ToString("0.##", br)%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ===== VENDAS DO DIA (COM ITENS EXPANSIVEIS) ===== *@
        <div class="dsh-secao">
            <h3 class="dsh-secao-titulo">Vendas do Dia (@Model.Vendas.Count)</h3>
            @if (Model.Vendas.Count == 0)
            {
                <p class="dsh-vazio">Nenhuma venda registrada neste dia.</p>
            }
            else
            {
                <div class="dsh-tabela-container dsh-tabela-responsiva">
                    <table class="dsh-tabela dsh-tabela-vendas">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">Venda</th>
                                <th scope="col">Hora</th>
                                <th scope="col">Forma</th>
                                <th scope="col">Vendedor</th>
                                <th scope="col" class="dsh-num">Total</th>
                                <th scope="col" class="dsh-num">Recebido</th>
                                <th scope="col" class="dsh-num">Troco</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Vendas)
                            {
                                var vendaComItens = Model.VendasComItens.FirstOrDefault(vi => vi.Id == v.Id);
                                var temItens = vendaComItens?.Itens?.Count > 0;

                                <tr class="@(v.IsFechado ? "dsh-linha-fechada" : "") @(temItens ? "tem-itens" : "")">
                                    <td>
                                        @if (temItens)
                                        {
                                            <button type="button" class="dsh-expandir-btn" data-venda-id="@v.Id" aria-expanded="false" aria-controls="itens-venda-@v.Id" title="Ver itens da venda">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            </button>
                                        }
                                    </td>
                                    <td>#@v.Id</td>
                                    <td>@v.DataVenda.ToString("HH:mm", br)</td>
                                    <td>@v.MetodoPagamento</td>
                                    <td>@(string.IsNullOrEmpty(v.CodigoVendedor) ? "—" : v.CodigoVendedor)</td>
                                    <td class="dsh-num">@Dinheiro(v.Total)</td>
                                    <td class="dsh-num">@(v.ValorRecebido > 0 ? Dinheiro(v.ValorRecebido) : "—")</td>
                                    <td class="dsh-num">@(v.ValorTroco > 0 ? Dinheiro(v.ValorTroco) : "—")</td>
                                    <td>
                                        <span class="dsh-badge @(v.IsFechado ? "dsh-badge-fechado" : "dsh-badge-aberto")">
                                            @(v.IsFechado ? "Fechado" : "Aberto")
                                        </span>
                                    </td>
                                </tr>

                                @if (temItens)
                                {
                                    <tr class="dsh-itens-venda" id="itens-venda-@v.Id" style="display: none;">
                                        <td colspan="9">
                                            <div class="dsh-itens-container">
                                                <table class="dsh-tabela dsh-tabela-itens">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">Produto</th>
                                                            <th scope="col" class="dsh-num">Qtd</th>
                                                            <th scope="col" class="dsh-num">Preço Unit.</th>
                                                            <th scope="col" class="dsh-num">Subtotal</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in vendaComItens?.Itens ?? Enumerable.Empty<ControleEstoqueLoja.Controllers.DashboardItemVendaDetalhe>())
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <a asp-controller="Home" asp-action="Produto" asp-route-id="@item.ProdutoId">@item.Nome</a>
                                                                </td>
                                                                <td class="dsh-num">@Qtd(item.Quantidade) @item.Unidade</td>
                                                                <td class="dsh-num">@Dinheiro(item.PrecoUnitario)</td>
                                                                <td class="dsh-num">@Dinheiro(item.Subtotal)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}