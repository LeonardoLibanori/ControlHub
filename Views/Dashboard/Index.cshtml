@model ControleEstoqueLoja.Controllers.DashboardViewModel
@using System.Globalization
@inject ControleEstoqueLoja.Data.ApplicationDbContext _context
@{
    ViewData["Title"] = "Dashboard";

    var br = CultureInfo.GetCultureInfo("pt-BR");
    string Dinheiro(decimal valor) => valor.ToString("C", br);
    string Qtd(decimal valor) => valor.ToString("0.###", br);

    // Frase de variação
    string FraseVariacao()
    {
        if (Model.FaturamentoAtual == 0m && Model.FaturamentoAnterior == 0m)
            return "Sem vendas no período.";
        if (Model.FaturamentoAnterior == 0m)
            return "Ainda não há vendas no período anterior para comparar.";
        if (Model.VariacaoPercentual > 0m)
            return $"As vendas subiram {Model.VariacaoPercentual.Value.ToString("F1", CultureInfo.InvariantCulture)}% em relação ao período anterior.";
        if (Model.VariacaoPercentual < 0m)
            return $"As vendas caíram {Math.Abs(Model.VariacaoPercentual.Value).ToString("F1", CultureInfo.InvariantCulture)}% em relação ao período anterior.";
        return "As vendas ficaram estáveis em relação ao período anterior.";
    }

    string CorVariacao() => Model.VariacaoPercentual switch
    {
        > 0 => "var(--t-green)",
        < 0 => "var(--t-coral)",
        _ => "var(--text-soft)"
    };

    // Saudação
    var hora = DateTime.Now.Hour;
    string saudacaoPrefixo = hora < 12 ? "Bom dia" : (hora < 18 ? "Boa tarde" : "Boa noite");
    string nomeUsuario = "Dono";
    var email = User?.Identity?.Name;
    if (!string.IsNullOrEmpty(email))
    {
        var usuario = _context.Users.FirstOrDefault(u => u.Email == email);
        if (usuario != null && !string.IsNullOrEmpty(usuario.NomeExibicao))
            nomeUsuario = usuario.NomeExibicao;
    }
    string saudacao = $"{saudacaoPrefixo}, {nomeUsuario}";
}

<div class="dsh-container">

    <!-- 1. Cabeçalho: Saudação + frase de variação + seletor de período -->
    <header class="dsh-cabecalho">
        <div class="dsh-boas-vindas">
            <h1 class="dsh-saudacao">@saudacao</h1>
            <p class="dsh-frase-variacao" style="color:@CorVariacao()">@FraseVariacao()</p>
        </div>

        <nav class="dsh-periodo-seletor" aria-label="Período do dashboard" role="tablist">
            <a href="@Url.Action("Index", "Dashboard", new { periodo = "hoje" })"
               class="dsh-periodo-opcao @(Model.Periodo == "hoje" ? "is-ativo" : "")"
               role="tab" aria-selected="@(Model.Periodo == "hoje".ToString().ToLower())"
               data-periodo="hoje">Hoje</a>
            <a href="@Url.Action("Index", "Dashboard", new { periodo = "ontem" })"
               class="dsh-periodo-opcao @(Model.Periodo == "ontem" ? "is-ativo" : "")"
               role="tab" aria-selected="@(Model.Periodo == "ontem".ToString().ToLower())"
               data-periodo="ontem">Ontem</a>
            <a href="@Url.Action("Index", "Dashboard", new { periodo = "7dias" })"
               class="dsh-periodo-opcao @(Model.Periodo == "7dias" ? "is-ativo" : "")"
               role="tab" aria-selected="@(Model.Periodo == "7dias".ToString().ToLower())"
               data-periodo="7dias">7 dias</a>
            <a href="@Url.Action("Index", "Dashboard", new { periodo = "30dias" })"
               class="dsh-periodo-opcao @(Model.Periodo == "30dias" ? "is-ativo" : "")"
               role="tab" aria-selected="@(Model.Periodo == "30dias".ToString().ToLower())"
               data-periodo="30dias">30 dias</a>
            <a href="@Url.Action("Index", "Dashboard", new { periodo = "mes" })"
               class="dsh-periodo-opcao @(Model.Periodo == "mes" ? "is-ativo" : "")"
               role="tab" aria-selected="@(Model.Periodo == "mes".ToString().ToLower())"
               data-periodo="mes">Este mês</a>
            <a href="@Url.Action("Index", "Dashboard", new { periodo = "ano" })"
               class="dsh-periodo-opcao @(Model.Periodo == "ano" ? "is-ativo" : "")"
               role="tab" aria-selected="@(Model.Periodo == "ano".ToString().ToLower())"
               data-periodo="ano">Este ano</a>
        </nav>
    </header>

    <!-- 2. Quatro cartões KPI -->
    <section class="dsh-kpi-grade" aria-label="Indicadores principais">
        <!-- Faturamento -->
        <article class="dsh-kpi-card">
            <span class="dsh-kpi-ponto" style="background:var(--c-blue)"></span>
            <span class="dsh-kpi-rotulo">Faturamento</span>
            <strong class="dsh-kpi-valor">@Dinheiro(Model.FaturamentoAtual)</strong>
            <span class="dsh-kpi-variacao" style="color:@CorVariacao();background:@(Model.VariacaoPercentual > 0 ? "var(--s-green-fundo)" : (Model.VariacaoPercentual < 0 ? "var(--s-coral-fundo)" : "var(--s-slate-fundo)"))">
                @(Model.VariacaoPercentual == null ? "—" : (Model.VariacaoPercentual > 0 ? "+" : "") + Model.VariacaoPercentual.Value.ToString("F1", CultureInfo.InvariantCulture) + "%")
            </span>
            <span class="dsh-kpi-vs">vs período anterior</span>
        </article>

        <!-- Vendas (contagem) -->
        <article class="dsh-kpi-card">
            <span class="dsh-kpi-ponto" style="background:var(--c-violet)"></span>
            <span class="dsh-kpi-rotulo">Vendas</span>
            <strong class="dsh-kpi-valor">@Model.VendasAtual</strong>
            <span class="dsh-kpi-variacao" style="color:@(Model.VendasAnterior > 0 && Model.VendasAtual != Model.VendasAnterior ? (Model.VendasAtual > Model.VendasAnterior ? "var(--t-green)" : "var(--t-coral)") : "var(--text-soft)");background:@(Model.VendasAnterior > 0 && Model.VendasAtual != Model.VendasAnterior ? (Model.VendasAtual > Model.VendasAnterior ? "var(--s-green-fundo)" : "var(--s-coral-fundo)") : "var(--s-slate-fundo)")">
                @(Model.VendasAnterior > 0 ? (Model.VendasAtual > Model.VendasAnterior ? "+" : "") + ((decimal)(Model.VendasAtual - Model.VendasAnterior) / Model.VendasAnterior * 100m).ToString("F1", CultureInfo.InvariantCulture) + "%" : "—")
            </span>
            <span class="dsh-kpi-vs">vs período anterior</span>
        </article>

        <!-- Ticket médio -->
        <article class="dsh-kpi-card">
            <span class="dsh-kpi-ponto" style="background:var(--c-cyan)"></span>
            <span class="dsh-kpi-rotulo">Ticket médio</span>
            <strong class="dsh-kpi-valor">@Dinheiro(Model.TicketMedioAtual)</strong>
            <span class="dsh-kpi-variacao" style="color:@(Model.TicketMedioAnterior > 0 && Model.TicketMedioAtual != Model.TicketMedioAnterior ? (Model.TicketMedioAtual > Model.TicketMedioAnterior ? "var(--t-green)" : "var(--t-coral)") : "var(--text-soft)");background:@(Model.TicketMedioAnterior > 0 && Model.TicketMedioAtual != Model.TicketMedioAnterior ? (Model.TicketMedioAtual > Model.TicketMedioAnterior ? "var(--s-green-fundo)" : "var(--s-coral-fundo)") : "var(--s-slate-fundo)")">
                @(Model.TicketMedioAnterior > 0 ? (Model.TicketMedioAtual > Model.TicketMedioAnterior ? "+" : "") + ((Model.TicketMedioAtual - Model.TicketMedioAnterior) / Model.TicketMedioAnterior * 100m).ToString("F1", CultureInfo.InvariantCulture) + "%" : "—")
            </span>
            <span class="dsh-kpi-vs">vs período anterior</span>
        </article>

        <!-- Dinheiro na gaveta (sem selo de variação) -->
        <article class="dsh-kpi-card">
            <span class="dsh-kpi-ponto" style="background:var(--c-green)"></span>
            <span class="dsh-kpi-rotulo">Dinheiro na gaveta</span>
            <strong class="dsh-kpi-valor @(Model.SaldoGaveta < 0 ? "dsh-negativo" : "")">@Dinheiro(Model.SaldoGaveta)</strong>
            <span class="dsh-kpi-saldo-info">saldo de hoje</span>
        </article>
    </section>

    <!-- 3. Linha: Gráfico (esquerda 8 col) + Rosca formas de pagamento (direita 4 col) -->
    <section class="dsh-grafico-rosca" aria-label="Faturamento e formas de pagamento">
        <div class="dsh-grafico-wrapper">
            <div class="dsh-grafico-header">
                <h2 class="dsh-grafico-titulo">Vendas no período</h2>
                <div class="dsh-grafico-legenda">
                    <span class="dsh-legenda-item dsh-legenda-atual" aria-hidden="true">
                        <span class="dsh-legenda-cor" style="background:var(--c-blue)"></span>
                        Período atual
                    </span>
                    <span class="dsh-legenda-item dsh-legenda-anterior" aria-hidden="true">
                        <span class="dsh-legenda-cor" style="background:var(--c-slate)"></span>
                        Período anterior
                    </span>
                </div>
            </div>

            <div class="dsh-grafico-svg-container" role="img" aria-label="Gráfico de faturamento por @Model.Periodo">
                @{
                    // Preparar dados para o SVG
                    var maxValor = Model.SerieAtual.Where(s => s.ValorAtual.HasValue).Select(s => s.ValorAtual.Value).DefaultIfEmpty(0m).Max();
                    var maxAnterior = Model.SerieAnterior.Where(s => s.ValorAnterior.HasValue).Select(s => s.ValorAnterior.Value).DefaultIfEmpty(0m).Max();
                    var maxGeral = new[] { maxValor, maxAnterior }.Max();

                    var caminhoAtual = ControleEstoqueLoja.Data.GraficoSvg.CaminhoLinha(Model.SerieAtual.Select(s => s.ValorAtual).ToList(), maxGeral);
                    var caminhoAnterior = ControleEstoqueLoja.Data.GraficoSvg.CaminhoLinha(Model.SerieAnterior.Select(s => s.ValorAnterior).ToList(), maxGeral);
                    var areaAtual = ControleEstoqueLoja.Data.GraficoSvg.CaminhoArea(Model.SerieAtual.Select(s => s.ValorAtual).ToList(), maxGeral);
                    var ticks = ControleEstoqueLoja.Data.GraficoSvg.NiceTicks(maxGeral);
                }

                <svg class="dsh-grafico-svg" viewBox="0 0 720 260" aria-label="Gráfico de faturamento por @Model.Periodo: série atual em azul, anterior em cinza tracejado">
                    <!-- Grade horizontal (ticks) -->
                    @foreach (var tick in ticks)
                    {
                        var y = 16 + 244 * (1 - (double)tick / (double)(ticks.LastOrDefault() == 0 ? 1 : ticks.LastOrDefault()));
                        <text>
                            <line x1="56" y1="@y" x2="704" y2="@y" stroke="var(--line)" stroke-width="1" stroke-dasharray="4,4" />
                            <text x="52" y="@(y + 4)" font-size="12" fill="var(--text-soft)" text-anchor="end" style="font-family:'DM Sans', sans-serif">
                                R$ @tick.ToString("F0", CultureInfo.InvariantCulture)
                            </text>
                        </text>
                    }

                    <!-- Área do período atual -->
                    @if (!string.IsNullOrEmpty(areaAtual))
                    {
                        <path d="@areaAtual" fill="var(--s-blue-fundo)" opacity="0.5" />
                    }

                    <!-- Linha do período anterior (tracejada) -->
                    @if (!string.IsNullOrEmpty(caminhoAnterior))
                    {
                        <path d="@caminhoAnterior" fill="none" stroke="var(--c-slate)" stroke-width="2" stroke-dasharray="6,4" stroke-linecap="round" stroke-linejoin="round" />
                    }

                    <!-- Linha do período atual -->
                    @if (!string.IsNullOrEmpty(caminhoAtual))
                    {
                        <path d="@caminhoAtual" fill="none" stroke="var(--c-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    }

                    <!-- Pontos de captura (anchors) - um por bucket com valor -->
                    @for (int i = 0; i < Model.SerieAtual.Count; i++)
                    {
                        if (Model.SerieAtual[i].ValorAtual.HasValue)
                        {
                            var x = 56 + (i / (double)(Model.SerieAtual.Count - 1)) * 648;
                            var y = 16 + 244 * (1 - (double)Model.SerieAtual[i].ValorAtual.Value / (double)(ticks.LastOrDefault() == 0 ? 1 : ticks.LastOrDefault()));
                            var valor = Model.SerieAtual[i].ValorAtual.Value;
                            var anterior = Model.SerieAnterior.Count > i && Model.SerieAnterior[i].ValorAnterior.HasValue
                                ? Model.SerieAnterior[i].ValorAnterior.Value
                                : (decimal?)null;
                            var tooltip = $"{Model.SerieAtual[i].Rotulo} · R$ {valor.ToString("F2", CultureInfo.InvariantCulture)} · {(anterior.HasValue ? $"anterior R$ {anterior.Value.ToString("F2", CultureInfo.InvariantCulture)}" : "sem anterior")}";
                            var isSelecionado = Model.DiaSelecionado.HasValue && Model.SerieAtual[i].Rotulo.Contains(Model.DiaSelecionado.Value.ToString("dd/MM"));

                            <a href="@(Model.SerieAtual[i].ValorAtual.HasValue && Model.Periodo != "hoje" && Model.Periodo != "ontem"
                                ? Url.Action("Index", "Dashboard", new { periodo = Model.Periodo, data = DateTime.ParseExact(Model.SerieAtual[i].Rotulo, "dd/MM", br) })
                                : "#")"
                               class="dsh-grafico-ancora @(isSelecionado ? "is-selecionado" : "")"
                               style="left:@(x - 12)px; top:@(y - 12)px;"
                               aria-label="@tooltip"
                               data-tooltip="@tooltip"
                               data-valor="@valor.ToString("F2", CultureInfo.InvariantCulture)"
                               data-anterior="@(anterior?.ToString("F2", CultureInfo.InvariantCulture) ?? "")"
                               data-rotulo="@Model.SerieAtual[i].Rotulo"
                               tabindex="0"
                               role="button">
                                <span class="dsh-grafico-marcador @(isSelecionado ? "is-selecionado" : "")" aria-hidden="true"></span>
                            </a>
                        }
                    }

                    <!-- Eixo X - rótulos esparsos (máx 8) -->
                    @{
                        var step = Math.Max(1, Model.SerieAtual.Count / 8);
                        for (int i = 0; i < Model.SerieAtual.Count; i += step)
                        {
                            var x = 56 + (i / (double)(Model.SerieAtual.Count - 1)) * 648;
                            var rotulo = Model.SerieAtual[i].Rotulo;
                            <text>
                                <text x="@x" y="252" font-size="11" fill="var(--text-soft)" text-anchor="middle" style="font-family:'DM Sans', sans-serif">@rotulo</text>
                            </text>
                        }
                    }
                </svg>

                <!-- Tabela equivalente para leitores de tela -->
                <table class="dsh-grafico-tabela-sr" aria-hidden="true">
                    <caption>Dados do gráfico: @Model.Periodo</caption>
                    <thead>
                        <tr>
                            <th scope="col">Período</th>
                            <th scope="col">Faturamento Atual</th>
                            <th scope="col">Faturamento Anterior</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.SerieAtual.Count; i++)
                        {
                            var atual = Model.SerieAtual[i].ValorAtual?.ToString("F2", CultureInfo.InvariantCulture) ?? "—";
                            var anterior = Model.SerieAnterior.Count > i && Model.SerieAnterior[i].ValorAnterior.HasValue
                                ? Model.SerieAnterior[i].ValorAnterior.Value.ToString("F2", CultureInfo.InvariantCulture)
                                : "—";
                            <tr>
                                <th scope="row">@Model.SerieAtual[i].Rotulo</th>
                                <td>R$ @atual</td>
                                <td>R$ @anterior</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="dsh-grafico-vazio" style="display:@(Model.SerieAtual.All(s => !s.ValorAtual.HasValue) ? "block" : "none")">
                Sem vendas no período.
            </p>
        </div>

        <!-- Rosca de formas de pagamento -->
        <aside class="dsh-rosca-wrapper" aria-label="Formas de pagamento">
            <h2 class="dsh-rosca-titulo">Formas de pagamento</h2>

            @if (Model.FormasPagamento.Count == 0)
            {
                <p class="dsh-vazio">Sem vendas no período.</p>
            }
            else
            {
                <div class="dsh-rosca-container">
                    <svg class="dsh-rosca-svg" viewBox="0 0 200 200" role="img" aria-label="Distribuição de formas de pagamento">
                        @{
                            foreach (var fp in Model.FormasPagamento)
                            {
                                var dashArray = fp.DashArray.ToString("F2", CultureInfo.InvariantCulture);
                                var dashOffset = fp.DashOffset.ToString("F2", CultureInfo.InvariantCulture);
                                <circle cx="100" cy="100" r="40"
                                       fill="none"
                                       stroke="@fp.Cor"
                                       stroke-width="24"
                                       stroke-dasharray="@dashArray @(251.33m - fp.DashArray)"
                                       stroke-dashoffset="@dashOffset"
                                       stroke-linecap="butt" />
                            }
                        }
                        <!-- Total no centro -->
                        <text x="100" y="95" font-size="24" fill="var(--text)" text-anchor="middle" font-weight="700" font-family="'Manrope', sans-serif">
                            @Dinheiro(Model.FaturamentoAtual)
                        </text>
                        <text x="100" y="118" font-size="12" fill="var(--text-soft)" text-anchor="middle" font-family="'DM Sans', sans-serif">
                            Total do período
                        </text>
                    </svg>

                    <ul class="dsh-rosca-legenda" role="list" aria-label="Detalhamento das formas de pagamento">
                        @foreach (var fp in Model.FormasPagamento)
                        {
                            <li class="dsh-rosca-item">
                                <span class="dsh-rosca-cor" style="background:@fp.Cor" aria-hidden="true"></span>
                                <span class="dsh-rosca-nome">@fp.Metodo</span>
                                <span class="dsh-rosca-detalhes">
                                    <span class="dsh-rosca-pct">@fp.Percentual.ToString("F1", CultureInfo.InvariantCulture)%</span>
                                    <span class="dsh-rosca-val">@Dinheiro(fp.Valor)</span>
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </aside>
    </section>

    <!-- 4. Linha: Estoque baixo (esquerda 8 col) + Mais vendidos (direita 4 col) -->
    <section class="dsh-estoque-mais-vendidos" aria-label="Estoque baixo e mais vendidos">
        <!-- Estoque baixo - Tabela -->
        <div class="dsh-estoque-wrapper">
            <header class="dsh-secao-header">
                <h2 class="dsh-secao-titulo">Estoque baixo</h2>
                <a href="@Url.Action("Index", "Home")" class="dsh-link-ver-todos">Ver estoque</a>
            </header>

            @if (Model.EstoqueBaixo.Count == 0)
            {
                <p class="dsh-vazio">Nenhum produto abaixo do mínimo.</p>
            }
            else
            {
                <div class="dsh-tabela-container dsh-tabela-responsiva">
                    <table class="dsh-tabela" aria-label="Produtos com estoque abaixo do mínimo">
                        <thead>
                            <tr>
                                <th scope="col">Produto</th>
                                <th scope="col" class="dsh-num">Estoque</th>
                                <th scope="col" class="dsh-num">Mínimo</th>
                                <th scope="col">Situação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.EstoqueBaixo.Take(6))
                            {
                                var razao = p.EstoqueMinimo > 0 ? Math.Min(1m, p.Quantidade / p.EstoqueMinimo) : 0m;
                                var situacao = p.Quantidade <= 0m ? "Zerado" : "Baixo";
                                var classeSituacao = p.Quantidade <= 0m ? "dsh-situacao-zerado" : "dsh-situacao-baixo";
                                <tr class="@(p.Quantidade <= 0m ? "dsh-linha-zerado" : "")">
                                    <td>
                                        <a asp-controller="Home" asp-action="Produto" asp-route-id="@p.ProdutoId">@p.Nome</a>
                                    </td>
                                    <td class="dsh-num">@Qtd(p.Quantidade) @p.Unidade</td>
                                    <td class="dsh-num">@Qtd(p.EstoqueMinimo) @p.Unidade</td>
                                    <td>
                                        <span class="dsh-badge-situacao @classeSituacao">@situacao</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="dsh-estoque-total">
                    @Model.TotalEstoqueBaixo @(Model.TotalEstoqueBaixo == 1 ? "produto" : "produtos") abaixo do mínimo
                </p>
            }
        </div>

        <!-- Mais vendidos -->
        <div class="dsh-mais-vendidos-wrapper">
            <h2 class="dsh-secao-titulo">Mais vendidos</h2>

            @if (Model.MaisVendidos.Count == 0)
            {
                <p class="dsh-vazio">Sem vendas no período.</p>
            }
            else
            {
                <ol class="dsh-mais-vendidos-lista" aria-label="Top 5 produtos mais vendidos por valor">
                    @for (int i = 0; i < Model.MaisVendidos.Count; i++)
                    {
                        var p = Model.MaisVendidos[i];
                        <li class="dsh-mais-vendido-item">
                            <span class="dsh-mais-vendido-posicao">@(i + 1)</span>
                            <div class="dsh-mais-vendido-info">
                                <a asp-controller="Home" asp-action="Produto" asp-route-id="@p.ProdutoId" class="dsh-mais-vendido-nome">@p.Nome</a>
                                <span class="dsh-mais-vendido-qtd">@Qtd(p.Quantidade) @p.Unidade</span>
                            </div>
                            <div class="dsh-mais-vendido-valor-bar">
                                <strong class="dsh-mais-vendido-valor">@Dinheiro(p.Valor)</strong>
                                <div class="dsh-barra-relativa" role="img" aria-label="@p.BarraRelativa.ToString("F1", CultureInfo.InvariantCulture)% do maior">
                                    <div class="dsh-barra-fill" style="width:@p.BarraRelativa.ToString("F1", CultureInfo.InvariantCulture)%; background:var(--c-blue)"></div>
                                </div>
                            </div>
                        </li>
                    }
                </ol>
            }
        </div>
    </section>

    <!-- 5. Painel de detalhe do dia (entre linhas 3 e 4 quando ?data=) -->
    @if (Model.DiaSelecionado.HasValue)
    {
        <section class="dsh-detalhe-dia-container" id="detalhe-dia-container" aria-label="Detalhes do dia @Model.DiaSelecionado.Value.ToString("dd/MM/yyyy", br)">
            @await Html.PartialAsync("_DetalheDiaPartial", new ControleEstoqueLoja.Controllers.DashboardDetalheDiaViewModel
            {
                Dia = Model.DiaSelecionado.Value,
                TotalDia = Model.VendasDoDia.Sum(v => v.Total),
                NumeroVendas = Model.VendasDoDia.Count,
                TicketMedio = Model.VendasDoDia.Count == 0 ? 0m : Math.Round(Model.VendasDoDia.Sum(v => v.Total) / Model.VendasDoDia.Count, 2, MidpointRounding.AwayFromZero),
                Vendas = Model.VendasDoDia.Select(v => new ControleEstoqueLoja.Controllers.DashboardVendaDetalhe
                {
                    Id = v.Id,
                    DataVenda = v.DataVenda,
                    MetodoPagamento = v.MetodoPagamento,
                    Total = v.Total,
                    IsFechado = v.IsFechado,
                    CodigoVendedor = v.CodigoVendedor,
                    ValorRecebido = v.ValorRecebido,
                    ValorTroco = v.ValorTroco
                }).ToList(),
                TotalPorMetodo = Model.VendasDoDia
                    .GroupBy(v => v.MetodoPagamento)
                    .Select(g => new ControleEstoqueLoja.Controllers.DashboardTotalPorMetodo
                    {
                        Metodo = g.Key,
                        Total = g.Sum(v => v.Total)
                    }).ToList(),
                Suprimentos = new List<ControleEstoqueLoja.Controllers.DashboardMovimentacaoDetalhe>(),
                Sangrias = new List<ControleEstoqueLoja.Controllers.DashboardMovimentacaoDetalhe>(),
                CaixaFechado = false,
                Produtos = new List<ControleEstoqueLoja.Controllers.DashboardDiaProduto>(),
                VendasComItens = new List<ControleEstoqueLoja.Controllers.DashboardVendaComItens>()
            })
        </section>
    }

</div>

@section Scripts {
    <script>
        // Scripts existentes para o detalhe do dia (mantidos)
        (function () {
            'use strict';

            const container = document.getElementById('detalhe-dia-container');
            const conteudo = document.getElementById('detalhe-dia-conteudo');
            const titulo = document.getElementById('detalhe-dia-titulo');
            const btnFechar = document.getElementById('fecharDetalheDia');
            const colunas = document.querySelectorAll('.dsh-grafico-ancora[data-rotulo]');

            let diaAtual = null;

            function abrirDetalhe(dia, dias) {
                if (diaAtual === dia) {
                    fecharDetalhe();
                    return;
                }

                diaAtual = dia;
                container.style.display = 'block';
                conteudo.innerHTML = `
                    <div class="dsh-detalhe-loading">
                        <div class="dsh-loading-spinner"></div>
                        <p>Carregando detalhes do dia...</p>
                    </div>
                `;
                titulo.textContent = `Detalhes de ${formatarData(dia)}`;

                colunas.forEach(c => {
                    const isAtivo = c.dataset.rotulo === dia;
                    c.classList.toggle('is-selecionado', isAtivo);
                    c.setAttribute('aria-current', isAtivo ? 'true' : 'false');
                });

                fetch(`/Dashboard/DetalheDia?data=${dia}&dias=${dias}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(r => {
                        if (!r.ok) throw new Error('Erro ao carregar');
                        return r.text();
                    })
                    .then(html => {
                        conteudo.innerHTML = html;
                        inicializarExpandiveis();
                    })
                    .catch(err => {
                        conteudo.innerHTML = `
                            <div class="dsh-alert dsh-alert-erro">
                                Erro ao carregar detalhes: ${err.message}
                            </div>
                        `;
                    });
            }

            function fecharDetalhe() {
                diaAtual = null;
                container.style.display = 'none';
                conteudo.innerHTML = '';
                document.querySelectorAll('.dsh-grafico-ancora.is-selecionado').forEach(c => {
                    c.classList.remove('is-selecionado');
                    c.setAttribute('aria-current', 'false');
                });
            }

            function formatarData(iso) {
                const [y, m, d] = iso.split('-');
                return `${d}/${m}/${y}`;
            }

            function inicializarExpandiveis() {
                document.querySelectorAll('.dash-expandir-btn').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const vendaId = this.dataset.vendaId;
                        const linhaItens = document.getElementById(`itens-venda-${vendaId}`);
                        const expandido = this.getAttribute('aria-expanded') === 'true';

                        this.setAttribute('aria-expanded', !expandido);
                        linhaItens.style.display = expandido ? 'none' : 'table-row';
                        this.style.transform = expandido ? 'rotate(0deg)' : 'rotate(180deg)';
                    });
                });
            }

            document.querySelectorAll('.dsh-grafico-ancora').forEach(ancora => {
                ancora.addEventListener('click', function (e) {
                    e.preventDefault();
                    const dia = this.dataset.rotulo;
                    const dias = '@Model.Periodo';
                    if (!this.disabled && !this.classList.contains('dsh-grafico-ancora-vazio')) {
                        abrirDetalhe(dia, dias);
                    }
                });

                ancora.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });

            const btnFecharExistente = document.getElementById('fecharDetalheDia');
            if (btnFecharExistente) {
                btnFecharExistente.addEventListener('click', fecharDetalhe);
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && container?.style.display !== 'none') {
                    fecharDetalhe();
                }
            });

            @if (Model.DiaSelecionado.HasValue)
            {
                @:document.addEventListener('DOMContentLoaded', function () {
                @:    abrirDetalhe('@Model.DiaSelecionado.Value.ToString("yyyy-MM-dd")', '@Model.Periodo');
                @:});
            }
        })();
    </script>
}