@model ControleEstoqueLoja.Controllers.DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";

    // pt-BR explicito: a maquina de desenvolvimento roda em outra cultura e o
    // "R$ 1.234,56" viraria "1,234.56" sem isto.
    var br = CultureInfo.GetCultureInfo("pt-BR");
    string Dinheiro(decimal valor) => valor.ToString("C", br);

    // Quantidade: 3 casas no maximo (0,125 kg), sem zeros a direita.
    string Qtd(decimal valor) => valor.ToString("0.###", br);

    // A ALTURA da barra ja vem pronta do view-model (PercentualAltura): maior
    // dia = 100, dia com venda nunca abaixo de 4%, zero = 0. Calcular no
    // controller e nao aqui garante o mesmo numero para a view e para o teste.
    var janelaLonga = Model.Dias >= 30;
    string DataBarra(DateTime dia) => dia.ToString("yyyy-MM-dd", br);
    string DataCurta(DateTime dia) => dia.ToString("dd/MM", br);
    string SoDia(DateTime dia) => dia.ToString("dd", br);

    // aria-label de cada barra: "dd/MM/yyyy: R$ x". Vai no title tambem, entao
    // o valor continua legivel em 30 dias mesmo sem hover.
    string RotuloDia(ControleEstoqueLoja.Controllers.DashboardDiaSerie d)
        => $"{d.Dia.ToString("dd/MM/yyyy", br)}: {Dinheiro(d.Total)}";
}

<div class="main-container dash-container">
    <div class="dash-cabecalho">
        <div>
            <h1 class="dash-titulo">Dashboard</h1>
            <p class="dash-subtitulo">@(DateTime.Today.ToString("dd/MM/yyyy", br)) · conferência do dia</p>
        </div>

        @* Seletor de JANELA por link GET: sem JS, sem formulario, e a URL
           (?dias=30) continua compartilhavel — quem recebe o link ve a mesma
           janela. O controller so aceita 7 e 30 (regra do painel). *@
        <nav class="dash-periodo" aria-label="Período do gráfico">
            <a class="dash-periodo-opcao @((!janelaLonga) ? "is-ativo" : null)"
               href="@Url.Action("Index", "Dashboard", new { dias = 7 })"
               aria-current="@((!janelaLonga) ? "page" : null)">7 dias</a>
            <a class="dash-periodo-opcao @(janelaLonga ? "is-ativo" : null)"
               href="@Url.Action("Index", "Dashboard", new { dias = 30 })"
               aria-current="@(janelaLonga ? "page" : null)">30 dias</a>
        </nav>
    </div>

    @* ------------------------------------------------------------------
       TOTAL DA JANELA, acima do grafico: e o que a barra de 7/30 dias
       representa. "Vendas de hoje" (cartao) e o dia; este e o PERIODO.
    *@
    <div class="dash-periodo-total">
        <span class="dash-rotulo">@(Model.Dias == 30 ? "Últimos 30 dias" : "Últimos 7 dias")</span>
        <strong class="dash-valor">@Dinheiro(Model.TotalVendasPeriodo)</strong>
        <span class="dash-observacao">
            @(Model.NumeroVendasPeriodo == 1 ? "1 venda" : $"{Model.NumeroVendasPeriodo} vendas")
            · clique numa barra para ver o dia
        </span>
    </div>

    @* ------------------------------------------------------------------
       TRÊS CARTÕES. Rótulos deliberadamente DIFERENTES:
       "Vendas de hoje" é o faturamento do dia (todas as formas de pagamento);
       "Dinheiro na gaveta" é só o que está fisicamente no caixa (regra 7).
       São números diferentes de propósito - o mesmo número com dois nomes
       seria mentira na tela.
    *@
    <div class="dash-grade">
        <div class="dash-cartao">
            <span class="dash-rotulo">Vendas de hoje</span>
            <strong class="dash-valor">@Dinheiro(Model.TotalVendasHoje)</strong>
            <span class="dash-observacao">
                @Model.NumeroVendasHoje @(Model.NumeroVendasHoje == 1 ? "venda" : "vendas")
                · ticket médio @Dinheiro(Model.TicketMedio)
            </span>
        </div>

        <div class="dash-cartao">
            <span class="dash-rotulo">Dinheiro na gaveta</span>
            <strong class="dash-valor @((Model.SaldoGaveta < 0m) ? "dash-negativo" : null)">
                @Dinheiro(Model.SaldoGaveta)
            </strong>
            <span class="dash-observacao">
                Só vendas em dinheiro de hoje. É este número que limita a sangria.
            </span>
        </div>

        <div class="dash-cartao">
            <span class="dash-rotulo">Estoque baixo</span>
            <strong class="dash-valor @((Model.TotalEstoqueBaixo > 0) ? "dash-negativo" : null)">
                @(Model.TotalEstoqueBaixo == 1 ? "1 produto" : $"{Model.TotalEstoqueBaixo} produtos")
            </strong>
            <span class="dash-observacao">Abaixo do mínimo configurado</span>
        </div>
    </div>

    @* ------------------------------------------------------------------
       FORMAS DE PAGAMENTO. "Vendas de hoje" NÃO é "Dinheiro na gaveta":
       cartão e PIX entram no faturamento e NÃO deixam dinheiro no caixa.
    *@
    <div class="dash-secao">
        <h2 class="dash-titulo-secao">Vendas de hoje por forma de pagamento</h2>

        @if (Model.TotalPorMetodo.Count == 0)
        {
            <p class="dash-vazio">Nenhuma venda registrada hoje.</p>
        }
        else
        {
            <div class="dash-rolagem">
                <table class="dash-tabela">
                    <thead>
                        <tr>
                            <th scope="col">Forma</th>
                            <th scope="col" class="dash-num">Valor</th>
                            <th scope="col" class="dash-num">Vai para a gaveta?</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.TotalPorMetodo)
                        {
                            <tr>
                                <td>@m.Metodo</td>
                                <td class="dash-num">@Dinheiro(m.Total)</td>
                                <td class="dash-num">
                                    @(string.Equals(m.Metodo, ControleEstoqueLoja.Controllers.CaixaController.MetodoPagamentoDinheiro, StringComparison.Ordinal)
                                        ? "Sim"
                                        : "Não")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ------------------------------------------------------------------
       ÚLTIMOS 7 OU 30 DIAS em barras de HTML/CSS PURO: sem canvas, sem
       biblioteca, sem script. Cada barra é uma <div> com altura em % e um
       <a> em volta - clicar leva ao detalhe do dia.

       A ALTURA vem de PercentualAltura (calculada no view-model). O PISO de 4%
       existe porque 9,98 contra um maximo de 1.000 daria ~1%: sem o piso a
       barra arredondava para 0px e o dia sumia do grafico. Isso era o bug do
       dia de R$ 9,98 que nao aparecia.

       EM 30 DIAS o rotulo fica so com o dia ("04") e o valor so no title e
       no aria-label: 30 valores em texto nao cabem. A primeira barra e todo
       dia 1 ganham dd/MM, que e o que o dono precisa para se localizar.
    *@
    <div class="dash-secao">
        <h2 class="dash-titulo-secao">Vendas dos últimos @Model.Dias dias</h2>

        <div class="dash-rolagem @(janelaLonga ? "dash-rolagem-larga" : null)">
            <div class="dash-grafico @(janelaLonga ? "dash-grafico-longo" : null)"
                 role="group" aria-label="Vendas por dia nos últimos @Model.Dias dias">
                @foreach (var d in Model.SerieUltimos7Dias)
                {
                    var mostrarDataCompleta = !janelaLonga || d.Dia.Day == 1 || d.Dia == Model.SerieUltimos7Dias[0].Dia;
                    <a class="dash-coluna @(d.Total <= 0m ? "dash-coluna-vazia" : null)"
                       href="@Url.Action("Dia", "Dashboard", new { data = DataBarra(d.Dia), dias = Model.Dias })"
                       title="@RotuloDia(d)"
                       aria-label="@RotuloDia(d)">
                        @if (!janelaLonga)
                        {
                            <span class="dash-coluna-valor">@Dinheiro(d.Total)</span>
                        }
                        <span class="dash-coluna-trilho">
                            <span class="dash-coluna-barra" style="height: @(d.PercentualAltura.ToString("0.##", br))%"></span>
                        </span>
                        <span class="dash-coluna-dia">
                            @(mostrarDataCompleta ? DataCurta(d.Dia) : SoDia(d.Dia))
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------------------------
       ESTOQUE BAIXO: os 5 mais críticos. O total real vem no cartão acima -
       a lista é top 5, o número do cartão é o todo.
    *@
    <div class="dash-secao">
        <h2 class="dash-titulo-secao">Estoque baixo</h2>

        @if (Model.EstoqueBaixo.Count == 0)
        {
            <p class="dash-vazio">Nenhum produto abaixo do mínimo.</p>
        }
        else
        {
            <div class="dash-rolagem">
                <table class="dash-tabela">
                    <thead>
                        <tr>
                            <th scope="col">Produto</th>
                            <th scope="col" class="dash-num">Em estoque</th>
                            <th scope="col" class="dash-num">Mínimo</th>
                            <th scope="col" class="dash-num">Falta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.EstoqueBaixo)
                        {
                            <tr class="@((p.Quantidade <= 0m) ? "dash-linha-zero" : null)">
                                <td>
                                    <a asp-controller="Home" asp-action="Produto" asp-route-id="@p.ProdutoId">@p.Nome</a>
                                </td>
                                <td class="dash-num">@Qtd(p.Quantidade) @p.Unidade</td>
                                <td class="dash-num">@Qtd(p.EstoqueMinimo) @p.Unidade</td>
                                <td class="dash-num">@Qtd(p.Faltam) @p.Unidade</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalEstoqueBaixo > Model.EstoqueBaixo.Count)
            {
                <p class="dash-observacao">
                    Mostrando os @Model.EstoqueBaixo.Count mais críticos de
                    @(Model.TotalEstoqueBaixo == 1 ? "1 produto" : $"{Model.TotalEstoqueBaixo} produtos").
                    <a asp-controller="Home" asp-action="Index">Ver o estoque completo</a>
                </p>
            }
        }
    </div>

    @* ------------------------------------------------------------------
       ÚLTIMAS VENDAS: os 5 registros mais recentes, de qualquer dia. O link
       abre o histórico, que é quem tem o detalhe.
    *@
    <div class="dash-secao">
        <h2 class="dash-titulo-secao">Últimas vendas</h2>

        @if (Model.UltimasVendas.Count == 0)
        {
            <p class="dash-vazio">Nenhuma venda registrada.</p>
        }
        else
        {
            <div class="dash-rolagem">
                <table class="dash-tabela">
                    <thead>
                        <tr>
                            <th scope="col">Venda</th>
                            <th scope="col">Data</th>
                            <th scope="col">Forma</th>
                            <th scope="col" class="dash-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.UltimasVendas)
                        {
                            <tr>
                                <td>#@v.Id</td>
                                <td>@v.DataVenda.ToString("dd/MM/yyyy HH:mm", br)</td>
                                <td>@v.MetodoPagamento</td>
                                <td class="dash-num">@Dinheiro(v.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="dash-observacao">
                <a asp-controller="Caixa" asp-action="Historico">Ver o histórico completo</a>
            </p>
        }
    </div>
</div>