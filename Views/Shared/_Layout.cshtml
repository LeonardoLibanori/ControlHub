    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/admin-caixa.js"></script>

   

    @if (Context.Request.Query.ContainsKey("imprimirId"))
    {
        <script>
            window.addEventListener('load', function() {
                var url = '@Url.Action("GerarCupom", "Caixa")' + '?id=' + '@Context.Request.Query["imprimirId"]';
                window.open(url, '_blank');
                window.history.replaceState({}, document.title, window.location.pathname);
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // 1. Corretor de fundo escuro (Backdrop)
        // Usamos delegação de evento no document para evitar erro caso o modal não exista na página
        document.addEventListener('hidden.bs.modal', function (event) {
            if (event.target.id === 'modalAtalhos') {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.style.overflow = 'auto';
            }
        });

        document.addEventListener('keydown', function(e) {

            // AJUSTE DE SHELL 2: atalhos agora casam por event.code (KeyM/KeyC/
            // KeyE/KeyH, Digit1..7), que e IDENTICO em qualquer layout de teclado.
            // O codigo antigo comparava e.key ('m','c'...): em layout nao-US o
            // Alt+letra devolve outro caractere e o atalho simplesmente nao vinha.
            const modal = document.getElementById('modalAtalhos');
            // Estado REAL do overlay: a classe 'show' do Bootstrap, e nao
            // "getInstance() !== null" (que so diz que a instancia existe, mesmo
            // escondida - bug que fazia o Alt+M parar de abrir depois do 1o uso).
            const overlayAberto = !!(modal && modal.classList.contains('show'));
            const code = e.code || '';
            const A = window.LOJA_ACESSO || {};

            // NUMEROS 1..7 com o overlay aberto acionam os MESMOS botoes
            // (data-key), que chamam as mesmas funcoes de admin-caixa.js.
            if (overlayAberto && !e.altKey && /^Digit[1-7]$/.test(code)) {
                const botao = modal.querySelector('[data-key="' + code.slice(5) + '"]');
                if (botao) {
                    e.preventDefault();
                    botao.click();
                    const inst = bootstrap.Modal.getInstance(modal);
                    if (inst) inst.hide();
                    return;
                }
            }

            // ATALHOS DE NAVEGACAO - mesmas policies de antes (window.LOJA_ACESSO,
            // gerado pelo Razor a partir de IAuthorizationService). Atalho sem
            // policy = atalho que nao navega: o Operador nao chega no Historico
            // por teclado, assim como nao ve o item no menu.
            if (e.altKey && code === 'KeyC' && A.pdv) {           // Caixa (Dono e Operador)
                e.preventDefault();
                window.location.href = '/Caixa';
                return;
            }
            if (e.altKey && code === 'KeyH' && A.financeiro) {    // Historico de hoje (so Dono)
                e.preventDefault();
                window.location.href = '/Caixa/Historico?periodo=hoje';
                return;
            }
            if (e.altKey && code === 'KeyE' && A.pdv) {           // Estoque / Home
                e.preventDefault();
                window.location.href = '/Home/Index';
                return;
            }

            // ATALHO ALT + M - abre o menu (administrativo p/ Dono, do caixa p/
            // Operador). O modal so e renderizado quando temMenuAtalhos; quem nao
            // tem nenhum item simplesmente nao tem overlay para abrir.
            if (e.altKey && code === 'KeyM') {
                e.preventDefault();
                if (modal && !overlayAberto) {
                    bootstrap.Modal.getOrCreateInstance(modal).show();
                }
                return;
            }

            // LOGICA DO ESC - com o overlay do menu aberto, Esc o FECHA antes de
            // qualquer coisa (no PDV o campo de busca recebe foco e, se a limpeza
            // viesse primeiro, o Esc esvaziaria a busca em vez de fechar o menu).
            // Sem overlay: limpa a busca se ela esta em foco; senao, fecha o ajuda.
            if (code === 'Escape' || e.key === 'Escape') {
                if (window.Swal && Swal.isVisible()) return;

                if (overlayAberto) {
                    const inst = bootstrap.Modal.getInstance(modal);
                    if (inst) inst.hide();
                    return;
                }

                const campoBusca = document.getElementById("campoBusca");
                if (campoBusca && campoBusca === document.activeElement) {
                    campoBusca.value = "";
                    const sug = document.getElementById("sugestoes");
                    if (sug) sug.style.display = "none";
                    campoBusca.blur();
                    return;
                }

                const modalAjuda = document.getElementById("modalAjudaAtalhos");
                if (modalAjuda && modalAjuda.classList.contains("aberto")) {
                    // BUG-35: o overlay dos atalhos esconde por CSS com !important;
                    // a classe "aberto" e o caminho unico (mesmo peso do !important).
                    modalAjuda.classList.remove("aberto");
                }
            }
        });

        // Clique FORA (no backdrop ou fora do dialog) fecha o overlay do menu.
        // Em clique real o Bootstrap ja fecha (data-bs-backdrop padrao); este
        // handler cobre tambem o clique sintetico dos testes, que nao dispara o
        // mousedown que o Bootstrap observa.
        document.addEventListener('click', function (e) {
            const modal = document.getElementById('modalAtalhos');
            if (!modal || !modal.classList.contains('show')) return;
            const noBackdrop = e.target && e.target.classList && e.target.classList.contains('modal-backdrop');
            const dentroDoDialog = e.target && e.target.closest && e.target.closest('#modalAtalhos .modal-dialog');
            if (noBackdrop || !dentroDoDialog) {
                const inst = bootstrap.Modal.getInstance(modal);
                if (inst) inst.hide();
            }
        });

                                // Cole este bloco e verifique se não há nenhum ponto "." perdido antes ou depois dele
        function gerenciarVendedores() {
            try {
                const modalEl = document.getElementById('modalAtalhos');
                if (modalEl) {
                    const mAtalhos = bootstrap.Modal.getInstance(modalEl);
                    if (mAtalhos) mAtalhos.hide();
                }
            } catch (e) {
                console.log("Modal não estava aberto");
            }

            // BUG-13 (commit 4): quem NAO gerencia vendedores (Operador) vai direto
            // para a CONSULTA. O menu de dois passos ("Cadastrar Novo" / "Listar
            // Todos") ofereceria um cadastro que a rota recusa com 403 - nao se
            // oferece botao que nao funciona.
            if (!window.LOJA_ACESSO || !window.LOJA_ACESSO.vendedores) {
                abrirListagemVendedores();
                return;
            }

            Swal.fire({
                title: 'Gestão de vendedores',
                icon: 'info',
                showDenyButton: true,
                confirmButtonText: 'Cadastrar novo',
                denyButtonText: 'Listar todos',
                confirmButtonColor: '#c2a36d',
                denyButtonColor: '#548f87',
            }).then((result) => {
                if (result.isConfirmed) {
                    abrirFormularioCadastro();
                } else if (result.isDenied) {
                    abrirListagemVendedores();
                }
            });
        }

                async function abrirListagemVendedores() {
            // Tenta fechar o modal de atalhos se ele existir
            const el = document.getElementById('modalAtalhos');
            if (el) {
                const m = bootstrap.Modal.getInstance(el);
                if (m) m.hide();
            }

            // Abre um carregando para você saber que a função disparou
            Swal.showLoading();

            // BUG-13 (commit 4): o Operador consulta cupons, mas nao cadastra nem
            // exclui vendedor (PodeGerenciarVendedores e so do Dono).
            const podeMexer = !!(window.LOJA_ACESSO && window.LOJA_ACESSO.vendedores);

            try {
                const resp = await fetch('/Caixa/ListarVendedores');
                const vendedores = await resp.json();

                    let html = `
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Cupom</th>
                    ${podeMexer ? '<th class="text-end">Ações</th>' : ''}
                </tr>
            </thead>
            <tbody>
                ${vendedores.map(v => `
                    <tr>
                        <td>${v.nome}</td>
                        <td><b>${v.codigo}</b></td>
                        ${podeMexer ? `<td class="text-end">
                            <button class="btn btn-sm btn-danger" title="Desativar vendedor" aria-label="Desativar vendedor ${v.nome}" onclick="confirmarExclusaoVendedor('${v.codigo}')">
                                Desativar
                            </button>
                        </td>` : ''}
                    </tr>
                `).join('')}
            </tbody>
        </table>`;

                if(vendedores.length === 0) html = "Nenhum vendedor cadastrado.";

                // BUG-13 (commit 4): o objeto e o MESMO para os dois papeis. O que
                // muda e o botao de confirmar (cadastrar): so o Dono tem
                // PodeGerenciarVendedores, entao para o Operador a lista e consulta pura.
                const opcoes = {
                    title: 'Gestão de vendedores',
                    html: html, // Sua tabela com o botão de excluir
                    showCancelButton: true,
                    showConfirmButton: podeMexer,
                    confirmButtonText: 'Novo vendedor',
                    cancelButtonText: 'Fechar',
                    confirmButtonColor: '#c2a36d',
                    cancelButtonColor: '#39444a',
                    reverseButtons: true,          // Coloca o cancelar na esquerda e o confirmar na direita
                    width: '600px',
                    customClass: {
                        popup: 'swal-info'
                    }
                };

                // O ".then" tem de estar NA MESMA expressao do Swal.fire: aqui ele
                // estava solto depois do try/catch, o navegador acusava
                // "then is not defined" e o botao "NOVO VENDEDOR" nunca abria o
                // formulario. Corrigido de passagem por estar no mesmo trecho.
                Swal.fire(opcoes).then((result) => {
                    if (result.isConfirmed) {
                        abrirFormularioCadastro(); // Faz o botão "Novo Vendedor" da lista funcionar
                    }
                });

            } catch (e) {
                Swal.fire({
                    title: 'Erro',
                    text: 'Não foi possível buscar os dados.',
                    customClass: {
                        popup: 'swal-error'
                    }
                });
            }
        }

                function confirmarExclusaoVendedor(codigo) {
            Swal.fire({
                title: 'Excluir cupom?',
                text: `Deseja realmente remover o vendedor com cupom ${codigo}?`,
                customClass: {
                    popup: 'swal-warning'
                },
                showCancelButton: true,
                confirmButtonColor: '#9d4f55',
                cancelButtonColor: '#39444a',
                confirmButtonText: 'Sim, excluir!',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const params = new URLSearchParams();
                    params.append('codigo', codigo);

                    const resp = await fetch('/Caixa/ExcluirVendedor', {
                        method: 'POST',
                        body: params
                    });
                    const res = await resp.json();

                    if (res.success) {
                        Swal.fire({
                            title: 'Removido!',
                            text: 'O cupom foi desativado.',
                            customClass: {
                                popup: 'swal-success'
                            }
                        })
                            .then(() => abrirListagemVendedores()); // Recarrega a lista atualizada
                    } else {
                        Swal.fire({
                            title: 'Erro',
                            text: res.message,
                            customClass: {
                                popup: 'swal-error'
                            }
                        });
                    }
                }
            });
        }


                function abrirFormularioCadastro() {
            Swal.fire({
                title: 'Cadastrar vendedor',
                html: `
                    <div class="text-start">
                        <label class="form-label">Nome completo</label>
                        <input id="nomeV" class="swal2-input m-0 w-100" placeholder="Ex: Leonardo Silva">
                        <label class="form-label mt-3">Cupom (código)</label>
                        <input id="codV" class="swal2-input m-0 w-100" placeholder="Ex: LEO10">
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Salvar registro',
                cancelButtonText: 'Voltar',
                confirmButtonColor: '#c2a36d',
                cancelButtonColor: '#9d4f55',
                focusConfirm: false,
                preConfirm: () => {
                    const nome = document.getElementById('nomeV').value.toUpperCase();
                    const codigo = document.getElementById('codV').value.toUpperCase();
                    if (!nome || !codigo) {
                        Swal.showValidationMessage('Por favor, preencha todos os campos!');
                    }
                    return { nome, codigo };
                }
            }).then((res) => {
                if (res.isConfirmed) {
                    salvarVendedorNoBanco(res.value);
                } else if (res.dismiss === Swal.DismissReason.cancel) {
                    // Se ele clicar em VOLTAR, reabre a lista para não fechar tudo
                    abrirListagemVendedores();
                }
            });
        }

        async function salvarVendedorNoBanco(dados) {
            const params = new URLSearchParams();
            params.append('nome', dados.nome);
            params.append('codigo', dados.codigo);

            const resp = await fetch('/Caixa/CadastrarVendedor', { method: 'POST', body: params });
            const res = await resp.json();

            if (res.success) {
                Swal.fire({
                    title: 'Sucesso!',
                    text: 'Vendedor cadastrado com sucesso.',
                    customClass: {
                        popup: 'swal-success'
                    }
                })
                    .then(() => abrirListagemVendedores()); // Recarrega a lista
            } else {
                Swal.fire({
                    title: 'Erro',
                    text: res.message,
                    customClass: {
                        popup: 'swal-error'
                    }
                });
            }
        }

                let barcode = "";
        document.addEventListener('keydown', function (e) {
            // Se estiver em um campo de texto (como o CPF), não bipa
            if (e.target.tagName === "INPUT") return;

            if (e.key === "Enter") {
                if (barcode.length > 3) {
                    buscarProdutoPorCodigo(barcode);
                }
                barcode = "";
            } else {
                barcode += e.key;
            }
        });

        

                        function processarCodigoBalanca(codigo) {
            // Exemplo código: 2 00123 00500 1
            // idProduto = 123 | valorExtraido = 0.500
            const idProduto = parseInt(codigo.substring(1, 6));
            const pesoExtraido = parseFloat(codigo.substring(6, 12)) / 1000;

            fetch(`/Caixa/BuscarPorId?id=${idProduto}`).then(async r => {
                const p = await r.json();
                if(p.success) {
                    // Aqui passamos o pesoExtraido como a QUANTIDADE da venda
                    adicionarAoCarrinho(p.id, p.nome, p.preco, pesoExtraido);
                }
            });
        }



    </script>

