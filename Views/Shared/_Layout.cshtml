@*
    ==========================================================================
    BUG-13 (commit 4): MENU POR PAPEL.
    ==========================================================================
    O menu NAO decide permissao: ele apenas PERGUNTA, para as MESMAS policies
    que cada rota ja exige (Security/Policies.cs). E o mesmo
    IAuthorizationService do [Authorize(Policy = ...)] das actions, entao nao
    existe uma segunda regra escrita a mao que possa divergir da primeira.

    IMPORTANTE: esconder o botao e cortesia com o usuario, NAO seguranca. Quem
    barra de verdade continua sendo o [Authorize] da action - um Operador que
    digite /Usuarios na barra de enderecos recebe 403 do mesmo jeito.
    ==========================================================================
*@
@inject IAuthorizationService Autorizacao
@inject UserManager<Usuario> GerenciadorDeUsuarios
@{
    var autenticado = User.Identity?.IsAuthenticated == true;

    // BUG-34: aba ATIVA do menu. O operador precisa saber em qual tela esta
    // sem clicar: por isso o item da rota atual recebe a classe "active" e o
    // aria-current="page". Sao as MESMAS strings de rota usadas nos links
    // abaixo, entao nao existe uma segunda lista de nomes para divergir.
    var rotaAtual = ViewContext.RouteData.Values["controller"] as string ?? "";
    var acaoAtual = ViewContext.RouteData.Values["action"] as string ?? "";

    // Um item do menu esta ativo quando o controller bate. A acao so entra
    // para separar as duas telas do MESMO controller: Caixa/Index (o PDV) e
    // Caixa/Historico nao podem ficar os dois destacados ao mesmo tempo.
    bool MenuAtivo(string controller, string? acao = null)
    {
        if (!string.Equals(rotaAtual, controller, StringComparison.OrdinalIgnoreCase)) return false;
        return acao is null || string.Equals(acaoAtual, acao, StringComparison.OrdinalIgnoreCase);
    }

    var podeOperarPdv = false;
    var podeReimprimirCupom = false;
    var podeRegistrarSuprimento = false;
    var podeRegistrarSangria = false;
    var podeVerFinanceiro = false;
    var podeFecharCaixa = false;
    var podeGerenciarVendedores = false;
    var podeGerenciarUsuarios = false;
    var podeAcessarAdmin = false;

    if (autenticado)
    {
        podeOperarPdv = (await Autorizacao.AuthorizeAsync(User, Policies.PodeOperarPDV)).Succeeded;
        podeReimprimirCupom = (await Autorizacao.AuthorizeAsync(User, Policies.PodeReimprimirCupom)).Succeeded;
        podeRegistrarSuprimento = (await Autorizacao.AuthorizeAsync(User, Policies.PodeRegistrarSuprimento)).Succeeded;
        podeRegistrarSangria = (await Autorizacao.AuthorizeAsync(User, Policies.PodeRegistrarSangria)).Succeeded;
        podeVerFinanceiro = (await Autorizacao.AuthorizeAsync(User, Policies.PodeVerFinanceiro)).Succeeded;
        podeFecharCaixa = (await Autorizacao.AuthorizeAsync(User, Policies.PodeFecharCaixa)).Succeeded;
        podeGerenciarVendedores = (await Autorizacao.AuthorizeAsync(User, Policies.PodeGerenciarVendedores)).Succeeded;
        podeGerenciarUsuarios = (await Autorizacao.AuthorizeAsync(User, Policies.PodeGerenciarUsuarios)).Succeeded;
        podeAcessarAdmin = (await Autorizacao.AuthorizeAsync(User, Policies.PodeAcessarAdmin)).Succeeded;
    }

    // O modal Alt+M so existe se sobrar pelo menos um item para esta pessoa.
    var temMenuAtalhos = podeOperarPdv || podeRegistrarSuprimento || podeRegistrarSangria
                         || podeFecharCaixa || podeVerFinanceiro || podeReimprimirCupom
                         || podeGerenciarVendedores;

    // ---------------------------------------------------------------- "quem esta logado" ---
    // Nome: o login e por e-mail (Usuario.UserName == Email) e o nome bonito mora
    // em Usuario.NomeExibicao, que NAO esta no cookie. Uma consulta por pagina
    // (indice de UserName) em um SQLite local e irrelevante; se algum dia virar
    // caminho quente, o certo e gravar o NomeExibicao como claim no login.
    var nomeExibido = User.Identity?.Name;
    var papelExibido = "sem papel";

    if (autenticado)
    {
        var conta = await GerenciadorDeUsuarios.FindByNameAsync(User.Identity!.Name!);
        if (!string.IsNullOrWhiteSpace(conta?.NomeExibicao))
        {
            nomeExibido = conta!.NomeExibicao;
        }

        // Dono primeiro quando houver mais de um papel: e ele que explica tudo
        // o que a pessoa ve na tela.
        var papeis = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).ToList();
        papelExibido = papeis.Contains(Roles.Dono) ? Roles.Dono
                     : papeis.Count > 0 ? string.Join(" + ", papeis)
                     : "sem papel";
    }
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* BUG-05: token anti-forgery para os POSTs feitos por fetch() no admin-caixa.js.
       Os <form> normais ja emitem @Html.AntiForgeryToken(); este <meta> atende o JS,
       que envia o token no header X-CSRF-TOKEN (configurado em Program.cs).
       GetAndStoreTokens devolve o token em texto puro (o cookie continua sendo
       emitido, entao a validacao do [ValidateAntiForgeryToken] funciona). *@
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    @* BUG-13 (commit 4): o JS do painel (atalhos Alt+X e a gestao de vendedores)
       le daqui o que ESTE usuario pode fazer. Sai do mesmo IAuthorizationService
       das policies - nao e uma segunda regra escrita a mao no JavaScript. *@
    <script>
        window.LOJA_ACESSO = {
            pdv: @(podeOperarPdv ? "true" : "false"),
            financeiro: @(podeVerFinanceiro ? "true" : "false"),
            vendedores: @(podeGerenciarVendedores ? "true" : "false"),
            usuarios: @(podeGerenciarUsuarios ? "true" : "false"),
            admin: @(podeAcessarAdmin ? "true" : "false")
        };
    </script>
    @* Nome do produto: generico de proposito. A identidade visual da loja
       (CNPJ, endereco, telefone) ainda nao esta parametrizada - ver
       Views/Caixa/GerarCupom.cshtml e a secao "Dados da empresa" do README. *@
    <title>@ViewData["Title"] - Controle de Estoque e Caixa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/corporate-theme.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-0">
            <div class="container-fluid">
                @* BUG-33: a marca agora e SO o nome "ControlHub" (era "ESTOQUE &
                   CAIXA" com um icone de caixa). O nome vem do mesmo lugar que a
                   marca das exportacoes (Marca:Nome, padrao "ControlHub"), entao
                   a tela e o arquivo Excel passam a falar a mesma coisa.
                   O icone foi removido de proposito: a marca fica com o nome
                   sozinho, mais limpa e legivel. *@
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span>ControlHub</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Estoque e Caixa: PodeOperarPDV (Dono e Operador).
                           BUG-33: os icones foram removidos (o nome sozinho ja
                           diz tudo); os demais itens do menu mantem o icone. *@
                        @if (podeOperarPdv)
                        {
                            <li class="nav-item">
                                @* asp-controller="Home" mantido *@
                                <a class="nav-link text-dark @(MenuAtivo("Home") ? "active" : null)"
                                   aria-current="@(MenuAtivo("Home") ? "page" : null)"
                                   asp-area="" asp-controller="Home" asp-action="Index">Estoque</a>
                            </li>
                            <li class="nav-item">
                                @* asp-controller="Caixa" mantido; a acao separa o
                                   PDV (Index) do Historico, que sao do mesmo
                                   controller - sem isso os dois ficariam ativos. *@
                                <a class="nav-link text-dark @(MenuAtivo("Caixa", "Index") ? "active" : null)"
                                   aria-current="@(MenuAtivo("Caixa", "Index") ? "page" : null)"
                                   asp-controller="Caixa" asp-action="Index">Caixa</a>
                            </li>
                        }

                        @* Histórico: PodeVerFinanceiro (só Dono) - some para o Operador. *@
                        @if (podeVerFinanceiro)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(MenuAtivo("Caixa", "Historico") ? "active" : null)"
                                   aria-current="@(MenuAtivo("Caixa", "Historico") ? "page" : null)"
                                   href="/Caixa/Historico?periodo=hoje">Histórico</a>
                                <a class="d-none" href="/Caixa/Historico" aria-hidden="true" tabindex="-1"></a>
                            </li>
                        }

                        @* Dashboard: PodeVerFinanceiro (so Dono) - o painel mostra
                           faturamento e saldo da gaveta, que nao sao negocio do
                           Operador. Reaproveita a variavel ja resolvida no topo
                           do _Layout, sem uma Authorize nova aqui.

                           Mudancas (BUG-32): o item saiu do INICIO da barra para
                           DEPOIS de Historico e passou a se chamar "Dashboard"
                           (antes "Inicio"). A rota nao mudou - continua
                           Dashboard/Index, que e o que os testes e os atalhos
                           usam. BUG-33: sem icone - a barra usa so o nome. *@
                        @if (podeVerFinanceiro)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(MenuAtivo("Dashboard") ? "active" : null)"
                                   aria-current="@(MenuAtivo("Dashboard") ? "page" : null)"
                                   asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                        }

                        @* O link /Usuarios saiu da barra: hoje a rota vive dentro do
                           menu de perfil (dropdown a direita), para a navbar ficar
                           clean. O Operador nao vê a opcao em lugar nenhum (e se
                           digitar a URL recebe 403 da propria rota). *@
                    </ul>

                    @if (autenticado)
                    {
                        @* Menu de perfil (clean): na barra fica SO o icone + "Olá, nome";
                           ao clicar abrem as opcoes - ADMINISTRAR USUARIOS (Dono, a
                           unica rota /Usuarios da interface) e SAIR (POST com token
                           anti-forgery: logout nao pode ser GET que qualquer pagina
                           dispararia). O papel fica DENTRO do menu: no balcao o PC e
                           compartilhado e saber quem entrou evita vender no cupom
                           errado, sem poluir a barra. *@
                        <div class="dropdown">
                            <button class="btn d-flex align-items-center gap-2 px-2 text-dark user-session-trigger"
                                    type="button" id="btnMenuPerfil" data-bs-toggle="dropdown"
                                    aria-expanded="false" aria-label="Menu do perfil">
                                <i class="bi bi-person-circle fs-4" aria-hidden="true"></i>
                                <span class="small fw-semibold">Olá, <b class="text-dark">@nomeExibido</b></span>
                                <i class="bi bi-chevron-down small" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnMenuPerfil">
                                <li>
                                    <span class="dropdown-item-text small text-muted d-flex align-items-center justify-content-between">
                                        <span>Papel</span>
                                        <span class="badge bg-secondary">@papelExibido</span>
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @if (podeGerenciarUsuarios)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                            <i class="bi bi-people me-2" aria-hidden="true"></i>Usuários
                                        </a>
                                    </li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sair</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    
    <main role="main">


