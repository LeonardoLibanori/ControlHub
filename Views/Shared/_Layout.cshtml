@*
    ==========================================================================
    BUG-13 (commit 4): MENU POR PAPEL.
    ==========================================================================
    O menu NAO decide permissao: ele apenas PERGUNTA, para as MESMAS policies
    que cada rota ja exige (Security/Policies.cs). E o mesmo
    IAuthorizationService do [Authorize(Policy = ...)] das actions, entao nao
    existe uma segunda regra escrita a mao que possa divergir da primeira.

    IMPORTANTE: esconder o botao e cortesia com o usuario, NAO seguranca. Quem
    barra de verdade continua sendo o [Authorize] da action - um Operador que
    digite /Usuarios na barra de enderecos recebe 403 do mesmo jeito.
    ==========================================================================
*@
@inject IAuthorizationService Autorizacao
@inject UserManager<Usuario> GerenciadorDeUsuarios
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracao
@{
    var autenticado = User.Identity?.IsAuthenticated == true;

    // BUG-34: aba ATIVA do menu. O operador precisa saber em qual tela esta
    // sem clicar: por isso o item da rota atual recebe a classe "active" e o
    // aria-current="page". Sao as MESMAS strings de rota usadas nos links
    // abaixo, entao nao existe uma segunda lista de nomes para divergir.
    var rotaAtual = ViewContext.RouteData.Values["controller"] as string ?? "";
    var acaoAtual = ViewContext.RouteData.Values["action"] as string ?? "";

    // Um item do menu esta ativo quando o controller bate. A acao so entra
    // para separar as duas telas do MESMO controller: Caixa/Index (o PDV) e
    // Caixa/Historico nao podem ficar os dois destacados ao mesmo tempo.
    bool MenuAtivo(string controller, string? acao = null)
    {
        if (!string.Equals(rotaAtual, controller, StringComparison.OrdinalIgnoreCase)) return false;
        return acao is null || string.Equals(acaoAtual, acao, StringComparison.OrdinalIgnoreCase);
    }

    // Marca (Marca:Nome, padrao "ControlHub") e loja (Loja:Nome, vazio).
    // Mesma fonte das exportacoes - a tela e o Excel falam a mesma coisa.
    var marcaNome = Configuracao["Marca:Nome"];
    if (string.IsNullOrWhiteSpace(marcaNome)) { marcaNome = "ControlHub"; }
    var lojaNome = Configuracao["Loja:Nome"] ?? string.Empty;

    // Caminho da faixa superior: "grupo / pagina". Mapeia a rota atual para
    // um dos grupos do menu; fora do menu, cai no titulo da pagina.
    var (grupoAtual, paginaAtual) = (rotaAtual.ToLowerInvariant(), acaoAtual.ToLowerInvariant()) switch
    {
        ("home", _) => ("Operação", "Estoque"),
        ("caixa", "historico") => ("Gestão", "Histórico"),
        ("caixa", _) => ("Operação", "Caixa"),
        ("dashboard", _) => ("Gestão", "Dashboard"),
        _ => ((string?)null, (string?)null)
    };
    var caminhoTexto = paginaAtual ?? (ViewData["Title"] as string) ?? "";


    var podeOperarPdv = false;
    var podeReimprimirCupom = false;
    var podeRegistrarSuprimento = false;
    var podeRegistrarSangria = false;
    var podeVerFinanceiro = false;
    var podeFecharCaixa = false;
    var podeGerenciarVendedores = false;
    var podeGerenciarUsuarios = false;
    var podeAcessarAdmin = false;

    if (autenticado)
    {
        podeOperarPdv = (await Autorizacao.AuthorizeAsync(User, Policies.PodeOperarPDV)).Succeeded;
        podeReimprimirCupom = (await Autorizacao.AuthorizeAsync(User, Policies.PodeReimprimirCupom)).Succeeded;
        podeRegistrarSuprimento = (await Autorizacao.AuthorizeAsync(User, Policies.PodeRegistrarSuprimento)).Succeeded;
        podeRegistrarSangria = (await Autorizacao.AuthorizeAsync(User, Policies.PodeRegistrarSangria)).Succeeded;
        podeVerFinanceiro = (await Autorizacao.AuthorizeAsync(User, Policies.PodeVerFinanceiro)).Succeeded;
        podeFecharCaixa = (await Autorizacao.AuthorizeAsync(User, Policies.PodeFecharCaixa)).Succeeded;
        podeGerenciarVendedores = (await Autorizacao.AuthorizeAsync(User, Policies.PodeGerenciarVendedores)).Succeeded;
        podeGerenciarUsuarios = (await Autorizacao.AuthorizeAsync(User, Policies.PodeGerenciarUsuarios)).Succeeded;
        podeAcessarAdmin = (await Autorizacao.AuthorizeAsync(User, Policies.PodeAcessarAdmin)).Succeeded;
    }

    // O modal Alt+M so existe se sobrar pelo menos um item para esta pessoa.
    var temMenuAtalhos = podeOperarPdv || podeRegistrarSuprimento || podeRegistrarSangria
                         || podeFecharCaixa || podeVerFinanceiro || podeReimprimirCupom
                         || podeGerenciarVendedores;

    // ---------------------------------------------------------------- "quem esta logado" ---
    // Nome: o login e por e-mail (Usuario.UserName == Email) e o nome bonito mora
    // em Usuario.NomeExibicao, que NAO esta no cookie. Uma consulta por pagina
    // (indice de UserName) em um SQLite local e irrelevante; se algum dia virar
    // caminho quente, o certo e gravar o NomeExibicao como claim no login.
    var nomeExibido = User.Identity?.Name;
    var papelExibido = "sem papel";

    if (autenticado)
    {
        var conta = await GerenciadorDeUsuarios.FindByNameAsync(User.Identity!.Name!);
        if (!string.IsNullOrWhiteSpace(conta?.NomeExibicao))
        {
            nomeExibido = conta!.NomeExibicao;
        }

        // Dono primeiro quando houver mais de um papel: e ele que explica tudo
        // o que a pessoa ve na tela.
        var papeis = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).ToList();
        papelExibido = papeis.Contains(Roles.Dono) ? Roles.Dono
                     : papeis.Count > 0 ? string.Join(" + ", papeis)
                     : "sem papel";
    }
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* BUG-05: token anti-forgery para os POSTs feitos por fetch() no admin-caixa.js.
       Os <form> normais ja emitem @Html.AntiForgeryToken(); este <meta> atende o JS,
       que envia o token no header X-CSRF-TOKEN (configurado em Program.cs).
       GetAndStoreTokens devolve o token em texto puro (o cookie continua sendo
       emitido, entao a validacao do [ValidateAntiForgeryToken] funciona). *@
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    @* BUG-13 (commit 4): o JS do painel (atalhos Alt+X e a gestao de vendedores)
       le daqui o que ESTE usuario pode fazer. Sai do mesmo IAuthorizationService
       das policies - nao e uma segunda regra escrita a mao no JavaScript. *@
    <script>
        window.LOJA_ACESSO = {
            pdv: @(podeOperarPdv ? "true" : "false"),
            financeiro: @(podeVerFinanceiro ? "true" : "false"),
            vendedores: @(podeGerenciarVendedores ? "true" : "false"),
            usuarios: @(podeGerenciarUsuarios ? "true" : "false"),
            admin: @(podeAcessarAdmin ? "true" : "false")
        };
    </script>
    @* PASSO 2 DO REDESIGN - CHAVE DE TEMA (unica) + estado da sidebar.
       Roda ANTES de qualquer <link> de CSS: a pagina nasce com o data-theme
       certo e nao pisca no tema errado. Chave no localStorage:
       controlhub-tema ("auto" padrao, "claro" ou "escuro"). O estado de
       "recolher" a sidebar (desktop) vem de controlhub-sidebar. *@
    <script>
        (function () {
            var chave = 'controlhub-tema';
            var raiz = document.documentElement;
            var tema = 'auto';
            try {
                var salvo = localStorage.getItem(chave);
                if (salvo === 'claro' || salvo === 'escuro' || salvo === 'auto') { tema = salvo; }
            } catch (e) { tema = 'auto'; }

            // tema EFETIVO: com "auto" segue o sistema.
            var efetivo = tema;
            if (tema === 'auto') {
                efetivo = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'escuro' : 'claro';
            }
            if (efetivo === 'claro') { raiz.setAttribute('data-theme', 'light'); }
            else { raiz.setAttribute('data-theme', 'dark'); }

            // estado de recolher da sidebar (desktop)
            try {
                if (localStorage.getItem('controlhub-sidebar') === 'fechada') {
                    raiz.setAttribute('data-sidebar', 'fechada');
                }
            } catch (e) { }

            window.CONTROLHUB_TEMA = { chave: chave, valor: tema };
            window.aplicarTema = function (novo) {
                if (novo !== 'auto' && novo !== 'claro' && novo !== 'escuro') { return; }
                tema = novo;
                window.CONTROLHUB_TEMA.valor = novo;
                try { localStorage.setItem(chave, novo); } catch (e) { }
                var efi = novo;
                if (novo === 'auto') {
                    efi = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'escuro' : 'claro';
                }
                if (efi === 'claro') { raiz.setAttribute('data-theme', 'light'); }
                else { raiz.setAttribute('data-theme', 'dark'); }
                document.dispatchEvent(new CustomEvent('controlhub-tema', { detail: novo }));
            };
        })();
    </script>
    @* Nome do produto: generico de proposito. A identidade visual da loja
       (CNPJ, endereco, telefone) ainda nao esta parametrizada - ver
       Views/Caixa/GerarCupom.cshtml e a secao "Dados da empresa" do README. *@
    <title>@ViewData["Title"] - Controle de Estoque e Caixa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/corporate-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/perfil-seta.css" asp-append-version="true" />
</head>
<body>@if (autenticado)
{
    <div class="app-shell" id="appShell">
        <aside class="app-sidebar" id="app-sidebar" aria-label="Navegação principal">
            <div class="app-sidebar__top">
                <a class="app-brand" href="/" title="@marcaNome">@marcaNome</a>
                @if (!string.IsNullOrWhiteSpace(lojaNome))
                {
                    <span class="app-brand__loja">@lojaNome</span>
                }
            </div>
            <nav class="app-sidebar__nav">
                <div class="app-sidebar__grupo">Operação</div>
                <a class="app-sidebar__item @(MenuAtivo("Home") ? "active" : null)" href="/Home/Index" aria-current="@(MenuAtivo("Home") ? "page" : null)">Estoque</a>
                @if (podeVerFinanceiro)
                {
                    <a class="app-sidebar__item @(MenuAtivo("Caixa", "Index") ? "active" : null)" href="/Caixa" aria-current="@(MenuAtivo("Caixa", "Index") ? "page" : null)">Caixa</a>
                }
                @if (podeVerFinanceiro)
                {
                    <div class="app-sidebar__grupo">Gestão</div>
                    <a class="app-sidebar__item @(MenuAtivo("Caixa", "Historico") ? "active" : null)" asp-controller="Caixa" asp-action="Historico" asp-route-periodo="hoje" aria-current="@(MenuAtivo("Caixa", "Historico") ? "page" : null)">Histórico</a>
                    <a class="app-sidebar__item @(MenuAtivo("Dashboard") ? "active" : null)" href="/Dashboard" aria-current="@(MenuAtivo("Dashboard") ? "page" : null)">Dashboard</a>
                }
            </nav>
            <div class="app-sidebar__bottom">
                <div class="app-theme-linha">
                    <span class="app-theme-linha__rotulo">Tema</span>
                    <button type="button" class="app-theme" role="switch" aria-checked="true" aria-label="Modo escuro">
                        <span class="app-theme-knob" aria-hidden="true"></span>
                        <span class="app-theme-ico app-theme-moon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                        </span>
                        <span class="app-theme-ico app-theme-sun" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        </span>
                    </button>
                </div>
                <div class="app-usuario">
                    <button type="button" class="app-usuario__botao" id="btnUsuario" aria-haspopup="menu" aria-expanded="false" aria-controls="menuUsuario">
                        <span class="app-usuario__info">
                            <span class="app-usuario__nome">@nomeExibido</span>
                            <span class="app-usuario__papel">@papelExibido</span>
                        </span>
                        <span class="app-usuario__chevron" aria-hidden="true"></span>
                    </button>
                    <div class="app-menu" id="menuUsuario" role="menu" aria-hidden="true">
                        @if (podeGerenciarUsuarios)
                        {
                            <a class="app-menu__item" role="menuitem" asp-controller="Usuarios" asp-action="Index">Usuários</a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0" role="none">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="app-menu__item app-menu__item--sair" role="menuitem">Sair</button>
                        </form>
                    </div>
                </div>
            </div>
        </aside>
        <div class="app-main" id="appMain">
            <header class="app-header">
                <button class="app-hamburguer" id="btnMenu" type="button" aria-controls="app-sidebar" aria-expanded="true" aria-label="Abrir ou fechar o menu">
                    <span class="app-hamburguer__barra"></span>
                    <span class="app-hamburguer__barra"></span>
                    <span class="app-hamburguer__barra"></span>
                </button>
                <div class="app-caminho">
                    @if (grupoAtual != null)
                    {
                        <span class="app-caminho__grupo">@grupoAtual</span>
                        <span class="app-caminho__sep" aria-hidden="true">/</span>
                        <span class="app-caminho__pagina">@paginaAtual</span>
                    }
                    else
                    {
                        <span class="app-caminho__pagina">@caminhoTexto</span>
                    }
                </div>
            </header>
            <main class="app-content" id="appContent">@RenderBody()</main>
            <footer class="app-footer">
                <div class="container">&copy; 2026 - Controle de Estoque e Caixa</div>
            </footer>
        </div>
        <div class="cortina-sidebar" id="cortinaSidebar" aria-hidden="true"></div>
    </div>
    <script src="~/js/shell.js" asp-append-version="true"></script>
}
else
{
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-0">
            <div class="container-fluid">
                @* BUG-33: a marca agora e SO o nome "ControlHub" (era "ESTOQUE &
                   CAIXA" com um icone de caixa). O nome vem do mesmo lugar que a
                   marca das exportacoes (Marca:Nome, padrao "ControlHub"), entao
