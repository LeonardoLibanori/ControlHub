                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @if (podeGerenciarUsuarios)
                                {
                                <li>
                                    <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                        Usuários
                                    </a>
                                </li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">Sair</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    
    <main role="main">

        @RenderBody()
    </main>

    <footer class="footer text-muted text-center py-3">
        <div class="container" style="color: white;">
            &copy; 2026 - Controle de Estoque e Caixa
        </div>
    </footer>
}

        @* Modal Atalhos (Mantido) *@
        @if (temMenuAtalhos)
        {
        <div class="modal fade" id="modalAtalhos" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title">@(podeAcessarAdmin ? "Menu administrativo" : "Menu do caixa") (ALT + M)</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            @if (podeRegistrarSangria)
                            {
                            <div class="col-6">
                                <button class="btn btn-danger w-100 py-3 fw-bold shadow-sm d-flex align-items-center" data-key="1" onclick="prepararSangria()">
                                    <span style="width: 30px; text-align: left;">1 -</span>
                                    <span>Sangria</span>
                                </button>
                            </div>
                            }
                            @if (podeRegistrarSuprimento)
                            {
                            <div class="col-6">
                                <button class="btn btn-primary w-100 py-3 fw-bold shadow-sm d-flex align-items-center" data-key="2" onclick="prepararSuprimento()">
                                    <span style="width: 30px; text-align: left;">2 -</span>
                                    <span>Suprimento</span>
                                </button>
                            </div>
                            }
                            @if (podeFecharCaixa)
                            {
                            <div class="col-6">
                                <button class="btn btn-secondary w-100 py-3 fw-bold shadow-sm d-flex align-items-center" data-key="3" onclick="verStatusCaixa()">
