                <h3>Atalhos do sistema</h3>
                <hr>
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="fw-bold">Ajuda / atalhos</span>
