                        <kbd>Alt + H</kbd>
                    </div>
                    }

                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="fw-bold">Controle de estoque</span>
                        <kbd>Alt + E</kbd>
                    </div>
