                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="fw-bold">@(podeAcessarAdmin ? "Menu administrativo" : "Menu do caixa")</span>
                        <kbd>Alt + M</kbd>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span class="fw-bold">Ir para o caixa</span>
