                        <h5 class="modal-title"><i class="bi bi-sliders2 me-2" aria-hidden="true"></i>@(podeAcessarAdmin ? "MENU ADMINISTRATIVO" : "MENU DO CAIXA") (ALT + M)</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            @if (podeRegistrarSangria)
                            {
                            <div class="col-6">
