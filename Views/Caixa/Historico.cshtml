@model IEnumerable<ControleEstoqueLoja.Models.Venda>

@{
    var periodoAtivo = ViewBag.Periodo as string;
    var dataFiltro = ViewBag.DataSelecionada as DateTime?;
    var dataExport = ViewBag.DataExport as string;
    var periodoExport = ViewBag.PeriodoExport as string;
    var titulo = ViewBag.Titulo as string ?? "Histórico de Vendas";
    var subtitulo = ViewBag.Subtitulo as string;
    var limiteExcedido = ViewBag.LimiteExcedido as bool? == true;
    var quantidadeTotal = ViewBag.QuantidadeVendas as int? ?? (Model?.Count() ?? 0);
}

<div class="container history-summary py-4">
    <div class="row g-3 align-items-stretch mb-4">
        <div class="col-12 col-lg-5">
            <section class="history-hero h-100 p-4 history-cartao-link
                              @(periodoAtivo == "hoje" ? "is-ativo" : null)">
                <div class="section-eyebrow">Vendas de hoje</div>
                <h1 class="history-today-total mb-0">
                    @(ViewBag.FaturamentoHoje is decimal hojeVal ? hojeVal.ToString("C") : "R$ 0,00")
                </h1>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="hoje"
                   aria-current="@(periodoAtivo == "hoje" ? "true" : null)"
                   title="Ver as vendas de hoje"></a>
            </section>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <section class="history-metric h-100 p-3 history-cartao-link
                              @(periodoAtivo == "7dias" ? "is-ativo" : null)">
                <div class="section-eyebrow">Últimos 7 dias</div>
                <h3 class="mb-0">@(ViewBag.FaturamentoSemana is decimal sVal ? sVal.ToString("C") : "R$ 0,00")</h3>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="7dias"
                   aria-current="@(periodoAtivo == "7dias" ? "true" : null)"
                   title="Ver as vendas dos últimos 7 dias"></a>
            </section>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <section class="history-metric h-100 p-3 history-cartao-link
                              @(periodoAtivo == "mes" ? "is-ativo" : null)">
                <div class="section-eyebrow">Este mês</div>
                <h3 class="mb-0">@(ViewBag.FaturamentoMes is decimal mVal ? mVal.ToString("C") : "R$ 0,00")</h3>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="mes"
                   aria-current="@(periodoAtivo == "mes" ? "true" : null)"
                   title="Ver as vendas deste mês"></a>
            </section>
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <section class="history-metric h-100 p-3 history-cartao-link
                              @(periodoAtivo == "ano" ? "is-ativo" : null)">
                <div class="section-eyebrow">Este ano</div>
                <h3 class="mb-0">@(ViewBag.FaturamentoAno is decimal aVal ? aVal.ToString("C") : "R$ 0,00")</h3>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="ano"
                   aria-current="@(periodoAtivo == "ano" ? "true" : null)"
                   title="Ver as vendas deste ano"></a>
            </section>
        </div>
    </div>

            
<div class="history-filter">
    <form method="get" class="history-filter__form">

        <div class="history-filter__campo history-filter__campo--data">
            <label class="form-label fw-semibold" for="historico-data">
                Filtrar por dia
            </label>

            <input type="date"
                   id="historico-data"
                   name="data"
                   class="form-control"
                   value="@(dataFiltro.HasValue ? dataFiltro.Value.ToString("yyyy-MM-dd") : "")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <button type="submit"
                id="btn-buscar"
                class="btn btn-primary history-filter__btn">
            Buscar
        </button>

        <a id="btn-exportar"
           asp-controller="Caixa"
           asp-action="ExportarHistoricoExcel"
           asp-route-data="@dataExport"
           asp-route-periodo="@periodoExport"
           class="btn-exportar history-filter__btn"
           title="Baixar em Excel (.xlsx) exatamente o que a tela está mostrando">
            Exportar Excel
        </a>

    </form>
</div>


    <p class="history-filtro-ativo mb-4">
        Exibindo: <strong>@titulo</strong>
        <span class="history-filtro-obs">· o Excel sai deste mesmo período</span>
    </p>
</div>

<div class="main-container">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">@titulo</h1>
        @if (!string.IsNullOrWhiteSpace(subtitulo))
        {
            <p class="history-subtitulo mb-0 text-muted">@subtitulo</p>
        }
    </div>

    @if (limiteExcedido)
    {
        <div class="alert alert-warning history-aviso-limite d-flex align-items-center mb-3" role="alert">
            <div>
                Exibindo as 200 vendas mais recentes de um total de <strong>@quantidadeTotal</strong> vendas deste período.
            </div>
        </div>
    }

    <div class="tabela-card p-0">
        <table class="table table-hover mb-0 tabela-responsiva tabela-responsiva--historico">
            <thead class="table-dark">
                <tr>
                    <th class="col-id">ID</th>
                    <th class="col-data">Data</th>
                    <th class="col-valor">Total</th>
                    <th class="col-pagamento">Pagamento</th>
                    <th class="text-center col-acoes">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var venda in Model)
                    {
                        <tr>
                            <td class="col-id" data-label="ID">@venda.Id</td>
                            <td class="col-data" data-label="Data">@venda.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="col-valor" data-label="Total">@venda.TotalVenda.ToString("C")</td>
                            <td class="col-pagamento" data-label="Pagamento">@venda.MetodoPagamento</td>
                            <td class="text-center col-acoes" data-label="Ações" style="vertical-align: middle;">
                                <div class="d-flex flex-nowrap justify-content-center align-items-center gap-2">
                                    <button class="btn btn-outline-secondary btn-sm history-action"
                                            onclick="verDetalhes(@venda.Id)"
                                            title="Ver detalhes" aria-label="Ver detalhes da venda @venda.Id">
                                        Detalhes
                                    </button>

                                    <button class="btn btn-outline-secondary btn-sm history-action"
                                            onclick="reimprimirVenda(@venda.Id)"
                                            title="Reimprimir cupom" aria-label="Reimprimir venda @venda.Id">
                                        Imprimir
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">Nenhuma venda encontrada para este período.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="modalDetalhes" class="modal-overlay">
    <div class="modal-box history-details-modal">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Detalhes da venda</h4>
            <button class="btn-close" onclick="fecharDetalhes()"></button>
        </div>

        <div id="conteudoDetalhes" class="text-start">
        </div>

        <button class="btn btn-secondary w-100 mt-4" onclick="fecharDetalhes()">Fechar</button>
    </div>
</div>

<script>
    function verDetalhes(id) {
        fetch('/Caixa/ObterDetalhesVenda/' + id)
            .then(response => response.json())
            .then(data => {
                let itensHtml = '<table class="table table-sm text-start"><thead><tr><th>Produto</th><th>Qtd</th><th>Total</th></tr></thead><tbody>';

                data.itens.forEach(item => {
                    const unidade = item.unidade || 'un';
                    const quantidade = Number(item.quantidade).toLocaleString('pt-BR', {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: unidade === 'kg' ? 3 : 0
                    });
                    itensHtml += `<tr>
                        <td>${item.produto}</td>
                        <td>${quantidade} ${unidade}</td>
                        <td>R$ ${item.total.toFixed(2)}</td>
                    </tr>`;
                });
                itensHtml += '</tbody></table>';

                Swal.fire({
                    title: `Venda #${id}`,
                    html: `
                        <div class="text-start mb-2">
                            <strong>Vendedor (Cupom):</strong> ${data.vendedor}
                        </div>
                        ${itensHtml}
                    `,
                    customClass: {
                        popup: 'swal-info'
                    },
                    width: '500px'
                });
            })
            .catch(err => {
                console.error(err);
                Swal.fire({
                    title: 'Erro',
                    text: 'Não foi possível carregar os detalhes.',
                    customClass: {
                        popup: 'swal-error'
                    }
                });
            });
    }
</script>