@model IEnumerable<ControleEstoqueLoja.Models.Venda>

@{
    // FASE A - ITEM 3: a data REALMENTE filtrada nesta tela. O campo do form
    // abre em "hoje", mas depois de buscar outro dia e a querystring que manda:
    // sem ler daqui, o botao Exportar baixaria sempre o dia de hoje enquanto a
    // tela mostra outro - que e exatamente o tipo de divergencia que faz o dono
    // fechar o mes pelo arquivo errado. DataTime.TryParse em vez de converter
    // direto porque a querystring chega como string e pode vir invalida.
    var dataTela = DateTime.Today;
    var dataBruta = Context.Request.Query["data"].ToString();
    if (DateTime.TryParse(dataBruta, out var dataLida)) dataTela = dataLida;

    // BUG-34: o filtro ativo. "semana" / "mes" / "ano" vem do cartao clicado;
    // vazio = o filtro de dia (que e como a tela ja nascia). Este valor marca
    // QUAL filtro esta no ar, para o cartao correspondente ficar destacado e o
    // "<h1>" dizer o que esta sendo mostrado.
    var periodoAtivo = (Context.Request.Query["periodo"].ToString() ?? "").Trim().ToLowerInvariant();
    var filtroEhPeriodo = periodoAtivo is "semana" or "mes" or "ano";

    // Titulo do que esta em exibicao. Sem isso a tela mostrava "10/05/2026"
    // mesmo com as vendas da semana toda na lista.
    var tituloPeriodo = periodoAtivo switch
    {
        "semana" => "Últimos 7 dias",
        "mes" => $"{dataTela.ToString("MMMM", new System.Globalization.CultureInfo("pt-BR"))} de {dataTela.Year}",
        "ano" => $"Ano de {dataTela.Year}",
        _ => dataTela.ToString("dd/MM/yyyy")
    };

    // PEDIDO DO DONO (05/10/2026): "quero o calendario normal mesmo". O campo
    // de data volta a ser SEMPRE visivel, SEMPRE habilitado e SEM min/max
    // travado no periodo - a janela do controller continua existindo para a
    // lista/export, mas nao trava mais o <input type="date">. Escolher outro
    // dia e clicar Buscar limpa o periodo (o form nao envia ?periodo=), que e
    // o caminho oficial de voltar ao filtro de dia.

    // BUG-34: os valores que vao nos LINKS, formatados AQUI e nao dentro do
    // asp-route-data. As aspas de "yyyy-MM-dd" dentro do atributo do Tag Helper
    // quebram o Razor e o href sai lixo (virava ?data=%3F.ToString(&periodo=..).
    var dataExport = (ViewBag.DataExport as DateTime?)?.ToString("yyyy-MM-dd");
    var periodoExport = filtroEhPeriodo ? periodoAtivo : null;
}

<div class="container history-summary py-4">
    <div class="row g-3 align-items-stretch mb-4">
        <div class="col-12 col-lg-5">
            @* PEDIDO DO DONO (05/10/2026): o "VENDAS DE HOJE" virou badge
               clicavel - antes so dava para voltar para ele saindo pelo menu
               lateral. Mesmo padrao dos tres cartoes: <section> com <a>
               esticado por cima (stretched-link).
               Ele tambem e dono do destaque dourado: so existe UM badge
               dourado por vez, e o dourado MIGRA para o cartao quando um
               periodo esta ativo (antes os dois ficavam dourados juntos). *@
            <section class="history-hero h-100 p-4 history-cartao-link
                              @(filtroEhPeriodo ? null : "is-ativo")">
                <div class="section-eyebrow"><i class="bi bi-calendar-day me-2" aria-hidden="true"></i>VENDAS DE HOJE</div>
                <h1 class="history-today-total mb-0">
                    @{
                        var totalHoje = Model?.Where(v => v.DataVenda.Date == DateTime.Today).Sum(v => v.TotalVenda) ?? 0;
                    }
                    @totalHoje.ToString("C")
                </h1>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   aria-current="@(filtroEhPeriodo ? null : "true")"
                   title="Voltar para as vendas de hoje"></a>
            </section>
        </div>
        @* BUG-34: os tres cartoes viraram clicaveis. Cada um abre o Historico ja
           filtrado pelo periodo - a lista abaixo mostra as vendas da semana /
           do mes / do ano, igual ja acontecia com o filtro de dia.

           A CORRECAO (depois de duas tentativas ruins): o cartao CONTINUA sendo
           um <section>, visualmente IGUAL ao de "VENDAS DE HOJE". O link e um
           <a> vazio, absoluto, esticado por cima do cartao inteiro - e o que o
           Bootstrap chama de stretched-link. Assim nenhuma regra de layout do
           card precisa ser reinventada: o <section> continua com a mesma
           altura, o mesmo padding e a mesma borda. Trocar o <section> por <a>
           (o que fiz antes) quebrava tudo, porque <a> e inline e nao aceita
           height/padding como um bloco de verdade. *@
        <div class="col-12 col-md-4 col-lg-2">
            <section class="history-metric h-100 p-3 history-cartao-link
                              @(periodoAtivo == "semana" ? "is-ativo" : null)">
                <div class="section-eyebrow">ESTA SEMANA</div>
                <h3 class="mb-0">@(ViewBag.FaturamentoSemana?.ToString("C") ?? "R$ 0,00")</h3>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="semana"
                   aria-current="@(periodoAtivo == "semana" ? "true" : null)"
                   title="Ver as vendas dos últimos 7 dias"></a>
            </section>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <section class="history-metric h-100 p-3 history-cartao-link
                              @(periodoAtivo == "mes" ? "is-ativo" : null)">
                <div class="section-eyebrow">ESTE MÊS</div>
                <h3 class="mb-0">@(ViewBag.FaturamentoMes?.ToString("C") ?? "R$ 0,00")</h3>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="mes"
                   aria-current="@(periodoAtivo == "mes" ? "true" : null)"
                   title="Ver as vendas deste mês"></a>
            </section>
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <section class="history-metric h-100 p-3 history-cartao-link
                              @(periodoAtivo == "ano" ? "is-ativo" : null)">
                <div class="section-eyebrow">ESTE ANO</div>
                <h3 class="mb-0">@(ViewBag.FaturamentoAno?.ToString("C") ?? "R$ 0,00")</h3>
                <a class="stretched-link" asp-controller="Caixa" asp-action="Historico"
                   asp-route-periodo="ano"
                   aria-current="@(periodoAtivo == "ano" ? "true" : null)"
                   title="Ver as vendas deste ano"></a>
            </section>
        </div>
    </div>

    <div class="history-filter d-flex flex-wrap gap-3 align-items-end mb-4">
        @* PEDIDO DO DONO (05/10/2026): UM so campo de data, sempre visivel e
           habilitado - o filtro "Periodo: ... / campo desabilitado" foi
           removido. O form e flex DENTRO da barra: antes ele usava a classe
           inexistente "d-contents", virava uma caixa normal e o botao Buscar
           caia desalinhado, embaixo do input. O submit nao envia ?periodo=,
           entao Buscar tambem limpa o filtro de periodo.

           O Exportar continua FORA do form de proposito: um link dentro de um
           <form method="get"> segue o form, e o navegador fazia uma BUSCA em
           vez de baixar o arquivo. *@
        <form method="get" class="d-flex flex-grow-1 flex-wrap gap-3 align-items-end">
            <div class="flex-grow-1">
                <label class="form-label fw-semibold" for="historico-data">Filtrar por dia</label>
                <input type="date"
                       id="historico-data"
                       name="data"
                       class="form-control fw-bold"
                       value="@dataTela.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="btn btn-primary text-uppercase">
                <i class="bi bi-search me-2" aria-hidden="true"></i>Buscar
            </button>
        </form>

        @* BUG-34: o export respeita o MESMO periodo da tela - os dois valores
           ja vem prontos do bloco @{} acima. *@
        <a asp-controller="Caixa" asp-action="ExportarHistoricoExcel"
           asp-route-data="@dataExport"
           asp-route-periodo="@periodoExport"
           class="btn-exportar"
           title="Baixar em Excel (.xlsx) exatamente o que a tela está mostrando">
            <i class="bi bi-file-earmark-spreadsheet me-2" aria-hidden="true"></i>Exportar Excel
        </a>
    </div>

    @* BUG-34: qual filtro esta no ar. Antes o campo de data aparecia sempre
       numa data, mesmo com as vendas do ano inteiro na lista - e o export
       saia com o dia. *@
    <p class="history-filtro-ativo mb-4">
        Exibindo: <strong>@tituloPeriodo</strong>
        <span class="history-filtro-obs">· o Excel e o CSV saem deste mesmo período</span>
    </p>
</div>



<div class="main-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0"><i class="bi bi-clock-history me-2" aria-hidden="true"></i>HISTÓRICO DE VENDAS</h1>
    </div>

    <div class="tabela-card p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    @* O cabecalho dizia "Qtd. Itens" e a coluna mostra a DATA da
                       venda (@venda.DataVenda). Pior do que o rotulo errado: o
                       dono fechava o dia pelo arquivo e conferia a coluna
                       achando que era a quantidade - dois numeros que nunca
                       batem. Agora o rotulo diz o que a coluna mostra. *@
                    <th>Data</th>
                    <th>Total</th>
                    <th>Pagamento</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var venda in Model)
                    {
                        <tr>
                            <td>@venda.Id</td>
                            <td>@venda.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@venda.TotalVenda.ToString("C")</td>
                            <td>@venda.MetodoPagamento</td>
                            <td class="text-center" style="vertical-align: middle;">
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <button class="btn btn-outline-secondary btn-sm history-action"
                                            onclick="verDetalhes(@venda.Id)"
                                            title="Ver detalhes" aria-label="Ver detalhes da venda @venda.Id">
                                        <i class="bi bi-search" aria-hidden="true"></i>
                                    </button>

                                    <button class="btn btn-outline-secondary btn-sm history-action"
                                            onclick="reimprimirVenda(@venda.Id)"
                                            title="Reimprimir cupom" aria-label="Reimprimir venda @venda.Id">
                                        <i class="bi bi-printer" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">Nenhuma venda encontrada para este período.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="modalDetalhes" class="modal-overlay">
    <div class="modal-box history-details-modal">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">DETALHES DA VENDA</h4>
            <button class="btn-close" onclick="fecharDetalhes()"></button>
        </div>

        <div id="conteudoDetalhes" class="text-start">
        </div>

        <button class="btn btn-secondary w-100 mt-4" onclick="fecharDetalhes()">FECHAR</button>
    </div>
</div>

<script>
           function verDetalhes(id) {
        fetch('/Caixa/ObterDetalhesVenda/' + id)
            .then(response => response.json())
            .then(data => {
                let itensHtml = '<table class="table table-sm text-start"><thead><tr><th>Produto</th><th>Qtd</th><th>Total</th></tr></thead><tbody>';

                data.itens.forEach(item => {
                    const unidade = item.unidade || 'un';
                    const quantidade = Number(item.quantidade).toLocaleString('pt-BR', {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: unidade === 'kg' ? 3 : 0
                    });
                    itensHtml += `<tr>
                        <td>${item.produto}</td>
                        <td>${quantidade} ${unidade}</td>
                        <td>R$ ${item.total.toFixed(2)}</td>
                    </tr>`;
                });
                itensHtml += '</tbody></table>';

                Swal.fire({
                    title: `Venda #${id}`,
                    html: `
                        <div class="text-start mb-2">
                            <strong>Vendedor (Cupom):</strong> ${data.vendedor}
                        </div>
                        ${itensHtml}
                    `,
                    icon: 'info',
                    width: '500px'
                });
            })
            .catch(err => {
                console.error(err);
                Swal.fire('Erro', 'Não foi possível carregar os detalhes.', 'error');
            });
    }
</script>