@{
    ViewData["Title"] = "Acesso negado";
    Layout = "_Layout";
}

<div class="container auth-shell">
    <div class="card shadow-sm">
        <div class="card-body p-4 text-center">
            <h2 class="mb-2"><i class="bi bi-shield-lock" aria-hidden="true"></i> ACESSO NEGADO</h2>
            <p class="text-muted mb-3">
                Você está logado como <strong>@ViewData["PapelAtual"]</strong>,
                mas esta tela exige um nível de permissão maior.
            </p>
            <p class="small text-muted mb-4">
                Se você precisa destas telas, peça ao <strong>Dono</strong> da loja
                para revisar sua credencial.
            </p>
            <a asp-controller="Caixa" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Voltar ao PDV
            </a>
        </div>
    </div>
</div>
