@{
    ViewData["Title"] = "Acesso negado";
    Layout = "_Layout";
}

<div class="container" style="max-width: 460px; margin-top: 70px;">
    <div class="card shadow-sm border-danger">
        <div class="card-body p-4 text-center">
            <h2 class="mb-2">⛔ ACESSO NEGADO</h2>
            <p class="text-muted mb-3">
                Você está logado como <strong>@ViewData["PapelAtual"]</strong>,
                mas esta tela exige um nível de permissão maior.
            </p>
            <p class="small text-muted mb-4">
                Se você precisa destas telas, peça ao <strong>Dono</strong> da loja
                para revisar sua credencial.
            </p>
            <a asp-controller="Caixa" asp-action="Index" class="btn btn-dark px-4">
                Voltar ao PDV
            </a>
        </div>
    </div>
</div>
