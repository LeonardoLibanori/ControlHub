@model ControleEstoqueLoja.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_Layout";
}

<div class="container auth-shell">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="text-center mb-1"><i class="bi bi-shield-lock" aria-hidden="true"></i> Entrar</h2>
            <p class="text-center text-muted mb-4">Controle de Estoque</p>

            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <form method="post" asp-controller="Account" asp-action="Login">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" class="form-control" autofocus autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Senha" class="form-label fw-bold"></label>
                    <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold"><i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Entrar</button>
            </form>
        </div>
    </div>
</div>
