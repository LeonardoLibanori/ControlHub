@model ControleEstoqueLoja.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_LayoutLogin";
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var csrfInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var meta = document.querySelector('meta[name="csrf-token"]');
            if (csrfInput && meta && meta.content) {
                csrfInput.value = meta.content;
            }
        });
    </script>
}

<main class="login-cartao">
    <div class="login-marca">@(Context.RequestServices.GetRequiredService<Microsoft.Extensions.Configuration.IConfiguration>()["Marca:Nome"] ?? "ControlHub")</div>
    <p class="login-subtitulo">Acesse o painel de controle de estoque</p>

    @if (ViewData.ModelState[string.Empty]?.Errors.Any() == true)
    {
        var erro = ViewData.ModelState[string.Empty]
            ?.Errors.FirstOrDefault()?.ErrorMessage;
        var ehBloqueio = !string.IsNullOrEmpty(erro) && erro.Contains("Muitas tentativas");
        <div role="alert" id="alertaErro" class="@(ehBloqueio ? "alerta-bloqueio" : "alerta-senha")">@erro</div>
    }

    <form method="post" asp-controller="Account" asp-action="Login" id="formLogin">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="login-campo">
            <label class="login-label" for="Email">E-mail</label>
            <input asp-for="Email" id="Email" type="email" autofocus autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="login-campo">
            <label class="login-label" for="Senha">Senha</label>
            <input asp-for="Senha" id="senha" type="password" autocomplete="current-password" />
            <span asp-validation-for="Senha" class="text-danger small"></span>
            <div class="login-botoes-enviar">
                <button type="button" id="btnMostrarSenha" aria-pressed="false">Mostrar</button>
            </div>
            <span id="avisoCaps" class="login-capslock">Caps Lock ativado</span>
        </div>

        <button type="submit" id="btnEntrar" class="login-botao-entrar">Entrar</button>
    </form>
</main>
