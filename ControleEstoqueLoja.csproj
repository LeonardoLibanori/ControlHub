<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Views\NovaPasta\**" />
    <Content Remove="Views\NovaPasta\**" />
    <EmbeddedResource Remove="Views\NovaPasta\**" />
    <None Remove="Views\NovaPasta\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\FluxoCaixaController.cs" />
    <Compile Remove="Migrations\20260205115542_InitialCreate.Designer.cs" />
    <Compile Remove="Models\Class.cs" />
  </ItemGroup>

  <!-- A suite de QA fica dentro do repo, mas NAO faz parte do app:
       sem estas exclusoes o Web SDK compila os .cs de tests.QA no projeto web. -->
  <ItemGroup>
    <Compile Remove="tests.QA\**" />
    <Content Remove="tests.QA\**" />
    <EmbeddedResource Remove="tests.QA\**" />
    <None Remove="tests.QA\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Views\Caixa\Index1.cshtml" />
    <Content Remove="Views\Caixa\Index2.cshtml" />
    <Content Remove="Views\Caixa\Index3.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- NU1903 / CVE-2025-6965 (GHSA-2m69-gcr7-jv3q): o EF Core Sqlite traz
         SQLitePCLRaw 2.1.11 (SQLite 3.49.1, vulneravel). Pin direto na linha 2.x:
         o bundle 2.1.12 referencia lib.e_sqlite3 3.53.3 (SQLite corrigido, >= 3.50.2)
         sem mudar de major - zero breaking change com o provider do EF Core 10. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="controleestoque.db">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
